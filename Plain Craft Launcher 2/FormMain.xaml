<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:BRCL"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
    x:Name="WindMain" x:Class="FormMain" Style="{StaticResource MyWindow}"
    AllowDrop="True" Topmost="True" Title="BRCL　" AllowsTransparency="True" MinHeight="470" MinWidth="810"
    ScrollViewer.VerticalScrollBarVisibility="Disabled" Icon="/BRCL;component/Images/icon.ico" WindowStyle="None"
    ResizeMode="CanResize" Background="{x:Null}" d:DesignWidth="870" d:DesignHeight="520" Width="1180" Height="740"
    RenderTransformOrigin="0.5,0.5">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo ThumbnailClipMargin="{Binding Margin, ElementName=PanForm}" />
    </Window.TaskbarItemInfo>
    <Grid x:Name="PanBack" SnapsToDevicePixels="True" UseLayoutRounding="True" Margin="10" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TransformGroup>
                <RotateTransform x:Name="TransformRotate" Angle="0" />
                <ScaleTransform x:Name="TransformScale" ScaleX="0.985" ScaleY="0.985" />
                <TranslateTransform x:Name="TransformPos" X="0" Y="10" />
            </TransformGroup>
        </Grid.RenderTransform>
        <Rectangle x:Name="ResizerT" Stroke="{x:Null}" StrokeThickness="0.0001" Height="8" VerticalAlignment="Top" Margin="13,0" Cursor="SizeNS">
            <Rectangle.Fill>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#21000000" Offset="1" />
                    <GradientStop Color="#11000000" Offset="0.7" />
                    <GradientStop Color="#00000000" Offset="0" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle x:Name="ResizerB" Stroke="{x:Null}" StrokeThickness="0.0001" Height="8" VerticalAlignment="Bottom" Margin="13,0" Cursor="SizeNS">
            <Rectangle.Fill>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#21000000" Offset="0" />
                    <GradientStop Color="#11000000" Offset="0.3" />
                    <GradientStop Color="#00000000" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle x:Name="ResizerR" HorizontalAlignment="Right" Margin="0,13" Stroke="{x:Null}" StrokeThickness="0.0001" Width="8" Cursor="SizeWE">
            <Rectangle.Fill>
                <LinearGradientBrush EndPoint="1,0.5" StartPoint="0,0.5">
                    <GradientStop Color="#21000000" Offset="0" />
                    <GradientStop Color="#11000000" Offset="0.3" />
                    <GradientStop Color="#00000000" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle x:Name="ResizerL" HorizontalAlignment="Left" Stroke="{x:Null}" Width="8" Margin="0,13" StrokeThickness="0.0001" Cursor="SizeWE">
            <Rectangle.Fill>
                <LinearGradientBrush EndPoint="1,0.5" StartPoint="0,0.5">
                    <GradientStop Color="#21000000" Offset="1" />
                    <GradientStop Color="#11000000" Offset="0.7" />
                    <GradientStop Color="#00000000" Offset="0" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle x:Name="ResizerLT" HorizontalAlignment="Left" Stroke="{x:Null}" Width="13" StrokeThickness="0.0001" VerticalAlignment="Top" Height="13" Cursor="SizeNWSE">
            <Rectangle.Fill>
                <RadialGradientBrush Center="1,1" GradientOrigin="1,1" RadiusX="1" RadiusY="1">
                    <GradientStop Color="#21000000" Offset="0.2" />
                    <GradientStop Color="#00000000" Offset="1" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle x:Name="ResizerLB" HorizontalAlignment="Left" Stroke="{x:Null}" Width="13" StrokeThickness="0.0001" VerticalAlignment="Bottom" Height="13" Cursor="SizeNESW">
            <Rectangle.Fill>
                <RadialGradientBrush Center="1,0" GradientOrigin="1,0" RadiusX="1" RadiusY="1">
                    <GradientStop Color="#21000000" Offset="0.2" />
                    <GradientStop Color="#00000000" Offset="1" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle x:Name="ResizerRB" HorizontalAlignment="Right" Stroke="{x:Null}" Width="13" StrokeThickness="0.0001" VerticalAlignment="Bottom" Height="13" Cursor="SizeNWSE">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0,0" GradientOrigin="0,0" RadiusX="1" RadiusY="1">
                    <GradientStop Color="#21000000" Offset="0.2" />
                    <GradientStop Color="#00000000" Offset="1" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle x:Name="ResizerRT" HorizontalAlignment="Right" Stroke="{x:Null}" Width="13" StrokeThickness="0.0001" VerticalAlignment="Top" Height="13" Cursor="SizeNESW">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0,1" GradientOrigin="0,1" RadiusX="1" RadiusY="1">
                    <GradientStop Color="#21000000" Offset="0.2" />
                    <GradientStop Color="#00000000" Offset="1" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Border Margin="8" x:Name="BorderForm">
            <Border.Clip>
                <RectangleGeometry x:Name="RectForm" RadiusX="3" RadiusY="3" />
            </Border.Clip>
            <Grid x:Name="PanForm" SnapsToDevicePixels="False" UseLayoutRounding="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ColRail" Width="76" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <!-- 左侧导航栏：图标与标签居中；快捷键留在悬停提示和自动化元数据中。 -->
                <Border x:Name="PanRail" Grid.Column="0" Grid.RowSpan="2" Background="{DynamicResource ColorBrushRail}" BorderBrush="{DynamicResource ColorBrushRailLine}" BorderThickness="0,0,1,0">
                    <Grid Margin="0,14,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Height="44" Margin="0,0,0,8">
                            <Image Width="42" Height="42" Source="/BRCL;component/Images/LauncherLogo.png" RenderOptions.BitmapScalingMode="HighQuality" ToolTip="BRCL · BRS 专属启动器" />
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel VerticalAlignment="Top">
                            <local:MyNavItem x:Name="Rail0" Tag="0" Height="56" Margin="6,2" Background="Transparent" Cursor="Hand" ToolTip="启动（Ctrl+1）">
                                <Rectangle x:Name="RailBar0" Width="3" HorizontalAlignment="Left" Fill="{DynamicResource IndustrialAccent}" Visibility="Collapsed" />
                                <TextBlock x:Name="RailNum0" Text="Ctrl+1" Visibility="Collapsed" />
                                <StackPanel x:Name="RailInner0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Path x:Name="RailIcon0" Data="{StaticResource BrclGeometryLaunch}" Fill="{DynamicResource IndustrialRailText}" Stretch="Uniform" Width="18" Height="18" Stroke="{x:Null}" />
                                    <TextBlock x:Name="RailText0" Text="启动" FontSize="10.5" HorizontalAlignment="Center" Margin="0,4,0,0" Foreground="{DynamicResource IndustrialRailText}" />
                                </StackPanel>
                            </local:MyNavItem>
                            <local:MyNavItem x:Name="Rail13" Tag="13" Height="56" Margin="6,2" Background="Transparent" Cursor="Hand" ToolTip="新闻（Ctrl+6）">
                                <Rectangle x:Name="RailBar13" Width="3" HorizontalAlignment="Left" Fill="{DynamicResource IndustrialAccent}" Visibility="Collapsed" />
                                <TextBlock x:Name="RailNum13" Text="Ctrl+6" Visibility="Collapsed" />
                                <StackPanel x:Name="RailInner13" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Path x:Name="RailIcon13" Data="{StaticResource BrclGeometryNews}" Fill="{DynamicResource IndustrialRailText}" Stretch="Uniform" Width="18" Height="18" Stroke="{x:Null}" />
                                    <TextBlock x:Name="RailText13" Text="新闻" FontSize="10.5" HorizontalAlignment="Center" Margin="0,4,0,0" Foreground="{DynamicResource IndustrialRailText}" />
                                </StackPanel>
                            </local:MyNavItem>
                            <local:MyNavItem x:Name="Rail10" Tag="10" Height="56" Margin="6,2" Background="Transparent" Cursor="Hand" ToolTip="BRS（Ctrl+2）">
                                <Rectangle x:Name="RailBar10" Width="3" HorizontalAlignment="Left" Fill="{DynamicResource IndustrialAccent}" Visibility="Collapsed" />
                                <TextBlock x:Name="RailNum10" Text="Ctrl+2" Visibility="Collapsed" />
                                <StackPanel x:Name="RailInner10" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Path x:Name="RailIcon10" Data="{StaticResource BrclGeometryServer}" Fill="{DynamicResource IndustrialRailText}" Stretch="Uniform" Width="18" Height="18" Stroke="{x:Null}" />
                                    <TextBlock x:Name="RailText10" Text="BRS" FontSize="10.5" HorizontalAlignment="Center" Margin="0,4,0,0" Foreground="{DynamicResource IndustrialRailText}" />
                                </StackPanel>
                            </local:MyNavItem>
                            <local:MyNavItem x:Name="Rail11" Tag="11" Height="56" Margin="6,2" Background="Transparent" Cursor="Hand" ToolTip="交易所（Ctrl+3）">
                                <Rectangle x:Name="RailBar11" Width="3" HorizontalAlignment="Left" Fill="{DynamicResource IndustrialAccent}" Visibility="Collapsed" />
                                <TextBlock x:Name="RailNum11" Text="Ctrl+3" Visibility="Collapsed" />
                                <StackPanel x:Name="RailInner11" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Path x:Name="RailIcon11" Data="{StaticResource BrclGeometryMarket}" Fill="{DynamicResource IndustrialRailText}" Stretch="Uniform" Width="18" Height="18" Stroke="{x:Null}" />
                                    <TextBlock x:Name="RailText11" Text="交易所" FontSize="10.5" HorizontalAlignment="Center" Margin="0,4,0,0" Foreground="{DynamicResource IndustrialRailText}" />
                                </StackPanel>
                            </local:MyNavItem>
                            <local:MyNavItem x:Name="Rail14" Tag="14" Height="56" Margin="6,2" Background="Transparent" Cursor="Hand" ToolTip="银行（Ctrl+7）">
                                <Rectangle x:Name="RailBar14" Width="3" HorizontalAlignment="Left" Fill="{DynamicResource IndustrialAccent}" Visibility="Collapsed" />
                                <TextBlock x:Name="RailNum14" Text="Ctrl+7" Visibility="Collapsed" />
                                <StackPanel x:Name="RailInner14" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Path x:Name="RailIcon14" Data="{StaticResource BrclGeometryBank}" Fill="{DynamicResource IndustrialRailText}" Stretch="Uniform" Width="18" Height="18" />
                                    <TextBlock x:Name="RailText14" Text="银行" FontSize="10.5" HorizontalAlignment="Center" Margin="0,4,0,0" Foreground="{DynamicResource IndustrialRailText}" />
                                </StackPanel>
                            </local:MyNavItem>
                            <local:MyNavItem x:Name="Rail12" Tag="12" Height="56" Margin="6,2" Background="Transparent" Cursor="Hand" ToolTip="卫星图（Ctrl+4）">
                                <Rectangle x:Name="RailBar12" Width="3" HorizontalAlignment="Left" Fill="{DynamicResource IndustrialAccent}" Visibility="Collapsed" />
                                <TextBlock x:Name="RailNum12" Text="Ctrl+4" Visibility="Collapsed" />
                                <StackPanel x:Name="RailInner12" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Path x:Name="RailIcon12" Data="{StaticResource BrclGeometryMap}" Stroke="{x:Null}" StrokeThickness="2" Fill="{DynamicResource IndustrialRailText}" Stretch="Uniform" Width="18" Height="18" />
                                    <TextBlock x:Name="RailText12" Text="卫星图" FontSize="10.5" HorizontalAlignment="Center" Margin="0,4,0,0" Foreground="{DynamicResource IndustrialRailText}" />
                                </StackPanel>
                            </local:MyNavItem>
                            <local:MyNavItem x:Name="Rail3" Tag="3" Height="56" Margin="6,2" Background="Transparent" Cursor="Hand" ToolTip="设置（Ctrl+5）">
                                <Rectangle x:Name="RailBar3" Width="3" HorizontalAlignment="Left" Fill="{DynamicResource IndustrialAccent}" Visibility="Collapsed" />
                                <TextBlock x:Name="RailNum3" Text="Ctrl+5" Visibility="Collapsed" />
                                <StackPanel x:Name="RailInner3" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Path x:Name="RailIcon3" Data="{StaticResource BrclGeometrySettings}" Fill="{DynamicResource IndustrialRailText}" Stretch="Uniform" Width="18" Height="18" Stroke="{x:Null}" />
                                    <TextBlock x:Name="RailText3" Text="设置" FontSize="10.5" HorizontalAlignment="Center" Margin="0,4,0,0" Foreground="{DynamicResource IndustrialRailText}" />
                                </StackPanel>
                            </local:MyNavItem>
                        </StackPanel>
                        </ScrollViewer>
                                <local:MyNavItem x:Name="RailThemeBtn" Grid.Row="2" Height="44" Margin="6,8,6,10" Background="Transparent" Cursor="Hand" ToolTip="切换浅色 / 深色">
                                    <TextBlock x:Name="RailNumTheme" Text="" FontFamily="Consolas" FontSize="8" Foreground="{DynamicResource IndustrialRailText}" Opacity="0.45" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,6,0" Visibility="Collapsed" />
                                    <StackPanel x:Name="RailThemeInner" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Path x:Name="RailThemeIcon" Data="{StaticResource BrclGeometrySun}" Fill="{DynamicResource IndustrialRailText}" Stretch="Uniform" Width="18" Height="18" />
                                        <TextBlock x:Name="RailThemeText" Text="主题" FontSize="10.5" HorizontalAlignment="Center" Margin="0,5,0,0" Foreground="{DynamicResource IndustrialRailText}" />
                                    </StackPanel>
                                </local:MyNavItem>
                    </Grid>
                </Border>
                <Canvas x:Name="ImgBack" IsHitTestVisible="False" Grid.Row="1" Grid.Column="1" RenderOptions.BitmapScalingMode="LowQuality"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                <Grid x:Name="PanTitle" Height="48" Grid.Column="1" Background="{DynamicResource ColorBrush8}">
                    <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource ColorBrushCardLine}" IsHitTestVisible="False" />
                    <local:MyImage x:Name="ImgTitle" IsHitTestVisible="False" Stretch="UniformToFill" IsEnabled="False" RenderOptions.BitmapScalingMode="LowQuality" />
                    <!-- 反馈底板不参与命中测试，保留标题栏空白处的拖拽区域。 -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Width="32" Height="30" Margin="0,0,8,0" CornerRadius="4" IsHitTestVisible="False">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=BtnTitleClose}" Value="True"><Setter Property="Background" Value="#33C42B1C" /></DataTrigger>
                                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=BtnTitleClose}" Value="True"><Setter Property="Background" Value="#33C42B1C" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Width="32" Height="30" Margin="0,0,44,0" CornerRadius="4" IsHitTestVisible="False">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=BtnTitleMax}" Value="True"><Setter Property="Background" Value="{DynamicResource ColorBrush6}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=BtnTitleMax}" Value="True"><Setter Property="Background" Value="{DynamicResource ColorBrush6}" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Width="32" Height="30" Margin="0,0,80,0" CornerRadius="4" IsHitTestVisible="False">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=BtnTitleMin}" Value="True"><Setter Property="Background" Value="{DynamicResource ColorBrush6}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=BtnTitleMin}" Value="True"><Setter Property="Background" Value="{DynamicResource ColorBrush6}" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <Rectangle Width="1" Height="14" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,128,0" Fill="{DynamicResource ColorBrushCardLine}" IsHitTestVisible="False" />
                    <local:MyIconButton x:Name="BtnTitleClose" AutomationProperties.Name="关闭启动器" ToolTip="关闭启动器" Focusable="True" KeyboardNavigation.IsTabStop="True" KeyboardNavigation.TabIndex="92" FocusVisualStyle="{StaticResource BrclFocusVisual}" HorizontalAlignment="Right" Height="30" VerticalAlignment="Center" Width="32" Margin="0,0,8,0" Theme="White"
                                       LogoScale="0.64" Logo="{StaticResource BrclIconClose}" KeyboardActivationHandledExternally="True" />
                    <local:MyIconButton x:Name="BtnTitleMax" AutomationProperties.Name="最大化" ToolTip="最大化" Focusable="True" KeyboardNavigation.IsTabStop="True" KeyboardNavigation.TabIndex="91" FocusVisualStyle="{StaticResource BrclFocusVisual}" HorizontalAlignment="Right" Height="30" VerticalAlignment="Center" Width="32" Margin="0,0,44,0" Theme="White"
                                       LogoScale="0.64" Logo="{StaticResource BrclIconMaximize}" KeyboardActivationHandledExternally="True" />
                    <local:MyIconButton x:Name="BtnTitleMin" AutomationProperties.Name="最小化" ToolTip="最小化" Focusable="True" KeyboardNavigation.IsTabStop="True" KeyboardNavigation.TabIndex="90" FocusVisualStyle="{StaticResource BrclFocusVisual}" HorizontalAlignment="Right" Height="30" VerticalAlignment="Center" Width="32" Margin="0,0,80,0" Theme="White"
                                       LogoScale="0.64" Logo="{StaticResource BrclIconMinimize}" KeyboardActivationHandledExternally="True" />
                    <Grid x:Name="PanTitleMain" HorizontalAlignment="Left" Width="{Binding ActualWidth, ElementName=PanTitle, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Path x:Name="ShapeTitleLogo" Data="M26,29 v-25 h6 a7,7 180 0 1 0,14 h-6 M62.5,6.5 a10,11.5 180 1 0 0,18 M71,2.5 v24.5 h13.5" SnapsToDevicePixels="False" UseLayoutRounding="False" IsHitTestVisible="False" HorizontalAlignment="Left" Margin="19,15.5,0,15.5" Stretch="fill" Stroke="White" StrokeThickness="2.2" Width="39" />
                        <TextBlock x:Name="LabTitleLogo" Visibility="Collapsed" SnapsToDevicePixels="False" UseLayoutRounding="False" IsHitTestVisible="False" HorizontalAlignment="Left" Margin="18,0,0,0" Foreground="White" FontSize="17" VerticalAlignment="Center" />
                        <local:MyImage x:Name="ImageTitleLogo" SnapsToDevicePixels="False" UseLayoutRounding="False" IsHitTestVisible="False" HorizontalAlignment="Left" Margin="19,0,0,0" VerticalAlignment="Center" Source="pack://application:,,,/BRCL;component/Images/TitleLogo.png" />
                        <StackPanel Grid.Column="1" x:Name="PanTitleSelect" HorizontalAlignment="Left" Height="27" VerticalAlignment="Center" Orientation="Horizontal" Margin="13,0">
                            <local:MyRadioButton x:Name="BtnTitleSelect0" Text="启动" Tag="0" Margin="5,0" Checked="True" Padding="2,0"
                                             LogoScale="0.9" Logo="{StaticResource BrclIconLaunch}"  ToolTip="启动（Ctrl+1）"/>
                            <local:MyRadioButton x:Name="BtnTitleSelectNews" Text="新闻" Tag="13" Margin="5,0" Padding="2,0" Logo="{StaticResource BrclIconNews}" ToolTip="新闻（Ctrl+6）" LogoScale="0.9" />
                            <local:MyRadioButton x:Name="BtnTitleSelect2" Text="联机" Tag="2" Margin="5,0" Padding="2,0"
                                             LogoScale="0.9" Logo="{StaticResource BrclIconLink}"/>
                            <local:MyRadioButton x:Name="BtnTitleSelectBrs" Text="BRS" Tag="10" Margin="5,0" Padding="2,0"
                                             LogoScale="0.9" Logo="{StaticResource BrclIconServer}"  ToolTip="BRS（Ctrl+2）"/>
                            <local:MyRadioButton x:Name="BtnTitleSelectStock" Text="交易所" Tag="11" Margin="5,0" Padding="2,0"
                                             LogoScale="0.9" Logo="{StaticResource BrclIconMarket}"  ToolTip="交易所（Ctrl+3）"/>
                            <local:MyRadioButton x:Name="BtnTitleSelectBank" Text="银行" Tag="14" Margin="5,0" Padding="2,0" Logo="{StaticResource BrclIconBank}" ToolTip="银行（Ctrl+7）" LogoScale="0.9" />
                            <local:MyRadioButton x:Name="BtnTitleSelectMap" Text="卫星图" Tag="12" Margin="5,0" Padding="2,0"
                                             Logo="{StaticResource BrclIconMap}" ToolTip="卫星图（Ctrl+4）" LogoScale="0.9" />
                            <local:MyRadioButton x:Name="BtnTitleSelect3" Text="设置" Tag="3" Margin="5,0" Padding="2,0"
                                             LogoScale="0.9" Logo="{StaticResource BrclIconSettings}" ToolTip="设置（Ctrl+5）"/>
                        </StackPanel>
                    </Grid>
                    <Path Data="M0,0 H7 V3 H3 V10 H0 Z M5,10 H10 V5 H13 V13 H5 Z" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="22,0,0,0" Fill="{DynamicResource IndustrialAccent}" IsHitTestVisible="False">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Visibility, ElementName=PanTitleInner}" Value="Visible"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                    <TextBlock x:Name="LabTitlePage" Text="启动" Margin="46,0,148,0" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                   Foreground="{DynamicResource ColorBrush1}" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <!-- 子页面标题在整个进出动画期间独占标题栏。 -->
                                    <DataTrigger Binding="{Binding Visibility, ElementName=PanTitleInner}" Value="Visible">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Grid x:Name="PanTitleInner" Visibility="Collapsed" Margin="-16,0,0,0" Opacity="0" HorizontalAlignment="Left" Width="{Binding ActualWidth, ElementName=PanTitle, Mode=OneWay}">
                        <Border HorizontalAlignment="Left" VerticalAlignment="Center" Width="32" Height="30" Margin="14,0,0,0" CornerRadius="4" IsHitTestVisible="False">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=BtnTitleInner}" Value="True"><Setter Property="Background" Value="{DynamicResource ColorBrush6}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=BtnTitleInner}" Value="True"><Setter Property="Background" Value="{DynamicResource ColorBrush6}" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <local:MyIconButton HorizontalAlignment="Left" VerticalAlignment="Center" Theme="White" x:Name="BtnTitleInner" Margin="14,0,0,0" Height="30" Width="32" AutomationProperties.Name="返回上一级" ToolTip="返回上一级（Esc）" Focusable="True" KeyboardNavigation.IsTabStop="True" KeyboardNavigation.TabIndex="0" FocusVisualStyle="{StaticResource BrclFocusVisual}"
                                             LogoScale="0.72" Logo="{StaticResource BrclIconBack}" KeyboardActivationHandledExternally="True" />
                        <TextBlock SnapsToDevicePixels="False" IsHitTestVisible="False" Name="LabTitleInner" VerticalAlignment="Center" Margin="56,0,148,0" Foreground="{DynamicResource ColorBrush1}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </Grid>
                </Grid>
                <local:IndustrialBackdrop x:Name="WorkspaceBackdrop" Grid.Row="1" Grid.Column="1"
                    SceneKey="PageLaunchRight" IsLightTheme="{DynamicResource BrclIsLightTheme}" LineBrush="{DynamicResource ColorBrush2}"
                    AccentBrush="{DynamicResource IndustrialAccent}" BaseBrush="{DynamicResource ColorBrush8}"
                    IsHitTestVisible="False" Focusable="False" />
                <Grid x:Name="PanLeft" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" SnapsToDevicePixels="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Rectangle x:Name="RectLeftBackground" Width="0" Fill="{DynamicResource ColorBrushBackgroundTransparentSidebar}" IsHitTestVisible="False" />
                    <Rectangle x:Name="RectLeftShadow" Width="4" HorizontalAlignment="Left" IsHitTestVisible="False" Grid.Column="1" >
                        <Rectangle.Fill>
                            <LinearGradientBrush EndPoint="1,0" StartPoint="0,0" Opacity="0.04">
                                <GradientStop Color="#000000" Offset="0"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>
                <Grid x:Name="PanMain" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="1" Grid.IsSharedSizeScope="True" UseLayoutRounding="True" SnapsToDevicePixels="True">
                        <Border x:Name="PanMainRight" RenderOptions.BitmapScalingMode="NearestNeighbor" UseLayoutRounding="False" SnapsToDevicePixels="False">
                        </Border>
