<Window x:Class="BrclUsageConsentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BRCL · 用户体验改善计划" ShowInTaskbar="False" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" SizeToContent="Height" Width="520"
        Background="{DynamicResource ColorBrush7}" Foreground="{DynamicResource ColorBrush1}"
        FontFamily="Microsoft YaHei UI" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True"
        KeyboardNavigation.TabNavigation="Cycle">
    <Window.Resources>
        <Style x:Key="ConsentAction" TargetType="Button" BasedOn="{StaticResource IndustrialAction}">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="6,9"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ColorBrush2}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Chrome" CornerRadius="4" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                           Foreground="{TemplateBinding Foreground}" TextWrapping="Wrap" TextAlignment="Center"
                                           HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="FocusOutline" CornerRadius="2" Margin="3" BorderThickness="1"
                                    BorderBrush="{TemplateBinding Foreground}" Visibility="Collapsed" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush"
                                        Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusOutline" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.78"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource ColorBrushCardLine}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel Margin="26,23,26,20">
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="9" VerticalAlignment="Top"
                                Background="{DynamicResource ColorBrush6}"
                                BorderBrush="{DynamicResource ColorBrushCardLine}" BorderThickness="1">
                            <Path Width="23" Height="23" Stretch="Uniform"
                                  Fill="{DynamicResource ColorBrush3}" Data="{StaticResource BrclGeometryShield}"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="13,0,6,0" VerticalAlignment="Center">
                            <TextBlock Text="BRCL 用户体验改善计划" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource ColorBrush2}"/>
                            <TextBlock Text="参与体验改善计划？" FontSize="24" FontWeight="SemiBold"
                                       Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="2" Width="32" Height="32" VerticalAlignment="Top"
                                Style="{StaticResource IndustrialAction}" Background="Transparent" BorderBrush="Transparent"
                                Padding="0" HorizontalContentAlignment="Center" TabIndex="3"
                                ToolTip="稍后决定，下次启动再询问 (Esc)" AutomationProperties.Name="稍后决定"
                                AutomationProperties.HelpText="下次启动再询问" Click="Dismiss_Click">
                            <Path Width="12" Height="12" Stretch="Uniform"
                                  Fill="{DynamicResource ColorBrush2}" Data="{StaticResource BrclGeometryClose}"/>
                        </Button>
                    </Grid>

                    <TextBlock Text="同意后，BRCL 会发送使用统计，并自动上传脱敏的崩溃日志，帮助定位和修复问题。"
                               TextWrapping="Wrap" LineHeight="22" Foreground="{DynamicResource ColorBrush2}"/>
                    <Border Margin="0,15,0,0" Padding="15,12" CornerRadius="6"
                            Background="{DynamicResource ColorBrush6}"
                            BorderBrush="{DynamicResource ColorBrushCardLine}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="使用记录" FontWeight="SemiBold"/>
                            <TextBlock Text="随机安装标识、BRCL 版本和记录时间"
                                       Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource ColorBrush2}"/>
                            <Border Height="1" Margin="0,10" Background="{DynamicResource ColorBrushCardLine}"/>
                            <TextBlock Text="游戏会话" FontWeight="SemiBold"/>
                            <TextBlock Text="游戏会话编号和崩溃诊断状态"
                                       Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource ColorBrush2}"/>
                        </StackPanel>
                    </Border>

                    <WrapPanel Margin="0,15,0,0">
                        <TextBlock Text="崩溃日志上传" Margin="0,0,10,0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource ColorBrush6}" BorderBrush="{DynamicResource ColorBrushCardLine}"
                                BorderThickness="1" CornerRadius="4" Padding="8,3">
                            <TextBlock Text="同意后自动开启" FontSize="12" Foreground="{DynamicResource ColorBrush1}"/>
                        </Border>
                    </WrapPanel>
                    <TextBlock Text="启动器、Minecraft 或 JVM 崩溃时，日志片段和异常堆栈会在本机脱敏后加密发送，不再逐次弹窗确认。日志正文保留 30 天。"
                               Margin="0,5,0,0" TextWrapping="Wrap" FontSize="13" LineHeight="21"
                               Foreground="{DynamicResource ColorBrush2}"/>

                    <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" FontSize="12" LineHeight="20"
                               Foreground="{DynamicResource ColorBrush2}">
                        前往设置中的 <Hyperlink Click="Privacy_Click" Focusable="True" KeyboardNavigation.TabIndex="2"
                                               FontWeight="SemiBold" Foreground="{DynamicResource ColorBrush3}">隐私与诊断</Hyperlink> 可单独关闭日志上传或退出计划。退出后停止上报并清除待发送数据。
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="1" Padding="26,14,26,17" BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource ColorBrushCardLine}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="DeclineButton" Content="不参与" Style="{StaticResource ConsentAction}"
                            TabIndex="0" Click="Decline_Click"/>
                    <Button Grid.Column="2" Content="同意并参与" Style="{StaticResource ConsentAction}"
                            Background="{DynamicResource IndustrialAccent}" BorderBrush="{DynamicResource IndustrialAccent}"
                            Foreground="{DynamicResource IndustrialOnAccent}"
                            TabIndex="1" Click="Accept_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
