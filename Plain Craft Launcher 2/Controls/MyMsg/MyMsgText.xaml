<Grid x:Class="MyMsgText" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:my="clr-namespace:PCL"
 RenderTransformOrigin="0.5,0.5" UseLayoutRounding="True" SnapsToDevicePixels="True"
 MinWidth="340" MaxWidth="640" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" KeyboardNavigation.TabNavigation="Cycle">
 <Grid.RenderTransform><TransformGroup><RotateTransform x:Name="TransformRotate" Angle="0"/><TranslateTransform x:Name="TransformPos" Y="8"/></TransformGroup></Grid.RenderTransform>
 <Border x:Name="PanBorder" CornerRadius="3" Background="{DynamicResource ColorBrush7}" BorderBrush="{DynamicResource ColorBrushCardLine}" BorderThickness="1">
  <Border.Effect><DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="4" Opacity="0.4" x:Name="EffectShadow"/></Border.Effect>
  <Grid><Rectangle Height="3" VerticalAlignment="Top" Fill="{DynamicResource IndustrialAccent}" IsHitTestVisible="False"/>
   <Grid x:Name="PanMain" Margin="24,23,24,22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="1"/><RowDefinition Height="16"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,16">
     <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Image Source="/BRCL;component/Images/LauncherLogo.png" Width="32" Height="32" VerticalAlignment="Top" Margin="0,2,10,0" RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False"/>
     <StackPanel Grid.Column="1"><TextBlock Text="BRCL / SYSTEM MESSAGE" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource ColorBrush2}"/><TextBlock x:Name="LabTitle" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource ColorBrush1}" TextWrapping="Wrap" Margin="0,6,12,0"/></StackPanel>
     <Border Grid.Column="2" Background="{DynamicResource ColorBrush6}" Padding="8,4" VerticalAlignment="Top"><TextBlock x:Name="LabKind" Text="提示" FontSize="11" Foreground="{DynamicResource ColorBrush2}"/></Border>
    </Grid>
    <Rectangle x:Name="ShapeLine" Grid.Row="1" Height="1" Fill="{DynamicResource ColorBrushCardLine}"/>
    <my:MyScrollViewer x:Name="PanCaption" Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0" Margin="0,0,0,18" DeltaMult="0.7">
     <StackPanel>
      <TextBlock x:Name="LabCaption" FontSize="14" LineHeight="22" TextWrapping="Wrap" Foreground="{DynamicResource ColorBrush1}"/>
      <StackPanel x:Name="PanAdvice" Margin="0,16,0,0" Visibility="Collapsed"><TextBlock Text="建议处理" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ColorBrush1}"/><TextBlock x:Name="LabAdvice" FontSize="13" LineHeight="21" TextWrapping="Wrap" Foreground="{DynamicResource ColorBrush2}" Margin="0,6,0,0"/></StackPanel>
      <Expander x:Name="PanDetails" Header="技术详情（用于排查）" Visibility="Collapsed" Margin="0,16,0,0" Foreground="{DynamicResource ColorBrush2}" FontSize="12">
       <TextBox x:Name="LabDetails" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="170" FontSize="11" FontFamily="Consolas, Microsoft YaHei UI" Foreground="{DynamicResource ColorBrush1}" Background="{DynamicResource ColorBrush6}" BorderBrush="{DynamicResource ColorBrushCardLine}" BorderThickness="1" Padding="10" Margin="0,8,0,0" AutomationProperties.Name="只读技术详情"/>
      </Expander>
     </StackPanel>
    </my:MyScrollViewer>
    <StackPanel Grid.Row="4">
     <Grid x:Name="PanDiagnostics" Visibility="Collapsed" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="LabCode" FontFamily="Consolas, Microsoft YaHei UI" FontSize="10" Foreground="{DynamicResource ColorBrush2}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0"/>
      <WrapPanel Grid.Column="1"><Button x:Name="BtnCopyDetails" Content="复制详情" Style="{StaticResource IndustrialAction}" Padding="9,6" FontSize="11" Margin="0,0,8,0"/><Button x:Name="BtnOpenLogs" Content="打开日志目录" Style="{StaticResource IndustrialAction}" Padding="9,6" FontSize="11"/></WrapPanel>
     </Grid>
     <WrapPanel x:Name="PanBtn" HorizontalAlignment="Right">
      <my:MyButton x:FieldModifier="public" x:Name="Btn1" Text="知道了" ColorType="Highlight" MinWidth="92" Height="38" TextPadding="8" Padding="12,0" Margin="8,4,0,0"/>
      <my:MyButton x:FieldModifier="public" x:Name="Btn2" ColorType="Normal" MinWidth="80" Height="38" TextPadding="8" Padding="12,0" Margin="8,4,0,0"/>
      <my:MyButton x:FieldModifier="public" x:Name="Btn3" ColorType="Normal" MinWidth="80" Height="38" TextPadding="8" Padding="12,0" Margin="8,4,0,0"/>
     </WrapPanel>
    </StackPanel>
   </Grid>
  </Grid>
 </Border>
</Grid>
