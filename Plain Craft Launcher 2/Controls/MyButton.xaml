<Border x:Class="MyButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FocusVisualStyle="{StaticResource BrclFocusVisual}" x:Name="PanBack"
             Focusable="True" UseLayoutRounding="False" SnapsToDevicePixels="False" Background="{StaticResource ColorBrushSemiTransparent}">
    <Border CornerRadius="2" x:Name="PanFore" BorderThickness="1" BorderBrush="{DynamicResource ColorBrush1}" RenderTransformOrigin="0.5,0.5" Background="{StaticResource ColorBrushHalfWhite}">
        <Border.RenderTransform>
            <ScaleTransform />
        </Border.RenderTransform>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
            <Path x:Name="ShapeIcon" Data="{Binding Icon, ElementName=PanBack}" Fill="{Binding Foreground, ElementName=LabText}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center">
                <Path.Style><Style TargetType="Path"><Style.Triggers>
                    <Trigger Property="Data" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                </Style.Triggers></Style></Path.Style>
            </Path>
        <TextBlock TextOptions.TextFormattingMode="Display" SnapsToDevicePixels="True" TextTrimming="None" HorizontalAlignment="Center" x:Name="LabText" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" Foreground="{Binding BorderBrush, ElementName=PanFore}" FontSize="13" IsHitTestVisible="False">
            <TextBlock.RenderTransform>
                <ScaleTransform />
            </TextBlock.RenderTransform>
        </TextBlock>
        </StackPanel>
    </Border>
</Border>
