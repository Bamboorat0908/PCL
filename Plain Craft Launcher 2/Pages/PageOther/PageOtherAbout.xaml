<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    mc:Ignorable="d" x:Class="PageOtherAbout"
    PanScroll="PanBack" RenderOptions.BitmapScalingMode="LowQuality">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10" Grid.IsSharedSizeScope="True">
            <local:MyCard Margin="0,15,0,0" Title="BRCL">
                <StackPanel Margin="21,40,21,16">
                    <TextBlock TextWrapping="Wrap" LineHeight="21" Margin="0,0,0,8"
                               Text="BRCL 是基于 Plain Craft Launcher 2 的二次创作版本，在原版基础上移除了下载与更多页面，并更换了名称与图标。" />
                    <TextBlock TextWrapping="Wrap" LineHeight="21" Margin="0,0,0,8"
                               Text="本版本遵循 Plain Craft Launcher 的分发有限许可：保留原作者龙腾猫跃的署名与许可声明，不用于商业用途。" />
                    <TextBlock TextWrapping="Wrap" LineHeight="21"
                               Text="原项目地址：https://github.com/Meloong-Git/PCL" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
