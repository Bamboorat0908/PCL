<local:MyPageRight xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL" x:Class="PageSpeedRight" PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel Margin="25,25,25,15" Grid.IsSharedSizeScope="True">
            <!-- PanMain 仅承载任务卡片，保持 BRCL 的完成/取消检测逻辑。 -->
            <StackPanel x:Name="PanMain" />
            <local:MyCard Title="下载时小游戏 · 小恐龙跑酷" Margin="0,0,0,15">
                <StackPanel Margin="20,40,20,18">
                    <DockPanel LastChildFill="True">
                        <local:MyButton x:Name="BtnGameToggle" DockPanel.Dock="Right" Text="玩一会儿" Height="30" MinWidth="92" Margin="12,0,0,0" />
                        <TextBlock Text="等下载的时间，陪小恐龙跑一会儿。" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource ColorBrush2}" />
                    </DockPanel>
                    <StackPanel x:Name="PanGame" Visibility="Collapsed" Margin="0,14,0,0" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
