<Grid x:Class="MyMsgLogin" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:BRCL"
 RenderTransformOrigin="0.5,0.5" UseLayoutRounding="True" SnapsToDevicePixels="True"
 MinWidth="340" MaxWidth="560" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center"
 KeyboardNavigation.TabNavigation="Cycle">
 <Grid.RenderTransform><TransformGroup><RotateTransform x:Name="TransformRotate" Angle="0"/><TranslateTransform x:Name="TransformPos" Y="8"/></TransformGroup></Grid.RenderTransform>
 <Border x:Name="PanBorder" CornerRadius="3" Background="{DynamicResource ColorBrush7}" BorderBrush="{DynamicResource ColorBrushCardLine}" BorderThickness="1">
  <Border.Effect><DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="4" Opacity="0.4" x:Name="EffectShadow"/></Border.Effect>
  <Grid><Rectangle Height="3" VerticalAlignment="Top" Fill="{DynamicResource IndustrialAccent}" IsHitTestVisible="False"/>
   <Grid x:Name="PanMain" Margin="24,23,24,22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="1"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16">
     <TextBlock Text="BRCL / MICROSOFT ACCOUNT" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource ColorBrush2}"/>
     <TextBlock x:Name="LabTitle" Text="登录 Minecraft" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource ColorBrush1}" Margin="0,6,0,0"/>
    </StackPanel>
    <Rectangle x:Name="ShapeLine" Grid.Row="1" Height="1" Fill="{DynamicResource ColorBrushCardLine}"/>
    <local:MyScrollViewer x:Name="PanCaption" Grid.Row="2" Margin="0,16,0,14" Padding="0,0,8,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" DeltaMult="0.7">
     <StackPanel>
      <TextBlock x:Name="LabCaption" FontSize="14" LineHeight="22" TextWrapping="Wrap" Foreground="{DynamicResource ColorBrush1}"/>
      <Border Background="{DynamicResource ColorBrush6}" BorderBrush="{DynamicResource ColorBrushCardLine}" BorderThickness="1" Padding="16,14" Margin="0,16,0,0">
       <StackPanel>
        <TextBlock Text="设备代码" FontSize="12" Foreground="{DynamicResource ColorBrush2}"/>
        <TextBlock x:Name="LabCode" FontFamily="Consolas" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource ColorBrush1}" Margin="0,6,0,8" TextWrapping="Wrap" AutomationProperties.Name="微软登录设备代码"/>
        <TextBlock x:Name="LabWebsite" FontSize="12" Foreground="{DynamicResource ColorBrush2}" TextWrapping="Wrap"/>
       </StackPanel>
      </Border>
      <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock x:Name="LabStatus" Text="等待浏览器授权" FontSize="12" Foreground="{DynamicResource ColorBrush1}" TextWrapping="Wrap" Margin="0,0,12,0" AutomationProperties.LiveSetting="Polite"/>
       <TextBlock x:Name="LabCountdown" Grid.Column="1" FontSize="12" FontFamily="Consolas, Microsoft YaHei UI" Foreground="{DynamicResource ColorBrush2}"/>
      </Grid>
      <TextBlock x:Name="LabHelp" FontSize="12" LineHeight="20" TextWrapping="Wrap" Foreground="{DynamicResource ColorBrush2}" Margin="0,12,0,0"/>
     </StackPanel>
    </local:MyScrollViewer>
    <WrapPanel x:Name="PanBtn" Grid.Row="3" HorizontalAlignment="Right">
     <local:MyButton x:FieldModifier="public" x:Name="Btn1" Text="打开登录网页" ColorType="Highlight" Height="38" MinWidth="120" Padding="12,0" TextPadding="8" Margin="8,4,0,0" AutomationProperties.Name="打开微软登录网页"/>
     <local:MyButton x:FieldModifier="public" x:Name="Btn2" Text="复制代码" Height="38" MinWidth="92" Padding="12,0" TextPadding="8" Margin="8,4,0,0" AutomationProperties.Name="复制微软登录设备代码"/>
     <local:MyButton x:FieldModifier="public" x:Name="Btn3" Text="取消" Height="38" MinWidth="72" Padding="12,0" TextPadding="8" Margin="8,4,0,0" AutomationProperties.Name="取消微软登录"/>
    </WrapPanel>
   </Grid>
  </Grid>
 </Border>
</Grid>
