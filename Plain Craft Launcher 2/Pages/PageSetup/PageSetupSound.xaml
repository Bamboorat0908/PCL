<local:MyPageRight xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:BRCL"
    x:Class="PageSetupSound" PanScroll="PanBack">
    <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,16,20,20">
            <local:MyCard Title="声音反馈">
                <StackPanel Margin="20,40,20,20">
                    <TextBlock Text="为每次操作添一点轻柔的回应。" TextWrapping="Wrap" Margin="0,0,0,16" Foreground="{DynamicResource ColorBrush2}" />
                    <local:MyCheckBox x:Name="CheckSoundEnabled" Text="启用音效" local:SettingService.Key="UiSoundEnabled" Height="24" />
                    <StackPanel x:Name="PanSoundOptions" Margin="0,18,0,0">
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                            <TextBlock Text="音效音量" VerticalAlignment="Center" Margin="0,0,24,0" />
                            <local:MySlider x:Name="SliderSoundVolume" AutomationProperties.Name="音效音量" Grid.Column="1" local:SettingService.Key="UiSoundVolume" MaxValue="100" ValueByKey="5" VerticalAlignment="Center" />
                            <TextBlock x:Name="LabSoundVolume" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <local:MyCheckBox x:Name="CheckSoundInteraction" Text="点击与按钮音效" local:SettingService.Key="UiSoundInteraction" Height="24" Margin="0,0,0,10" />
                        <local:MyCheckBox x:Name="CheckSoundStartup" Text="启动音效" local:SettingService.Key="UiSoundStartup" Height="24" />
                        <WrapPanel Margin="0,18,0,0">
                            <local:MyButton x:Name="BtnPreviewClick" Text="试听点击音效" Icon="{StaticResource BrclGeometryVolume}" Height="34" Padding="12,0" Margin="0,0,10,8" />
                            <local:MyButton x:Name="BtnPreviewStartup" SoundFeedback="False" Text="试听启动音效" Icon="{StaticResource BrclGeometryLaunch}" Height="34" Padding="12,0" Margin="0,0,0,8" />
                        </WrapPanel>
                    </StackPanel>
                    <TextBlock Text="音效音量独立于背景音乐。关闭后立即静音，下次启动仍会保留设置。" TextWrapping="Wrap" LineHeight="21" Margin="0,12,0,0" Foreground="{DynamicResource ColorBrush2}" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard Title="界面动效" Margin="0,14,0,0">
                <StackPanel Margin="20,40,20,20">
                    <local:MyCheckBox Text="减少动态效果" local:SettingService.Key="UiReduceMotion" Height="24" />
                    <TextBlock Text="减少窗口缩放和页面位移，让界面更安静。启动器也会遵循 Windows 的动画设置。" TextWrapping="Wrap" LineHeight="21" Margin="0,12,0,0" Foreground="{DynamicResource ColorBrush2}" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
