<local:MyPageRight xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:BRCL"
    x:Class="PageSetupSponsors" PanScroll="PanBack">
    <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,16,20,20">
            <local:MyCard UseAnimation="False">
                <StackPanel Margin="20,18">
                    <TextBlock Text="赞助鸣谢" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="感谢每一位支持 BRS 的伙伴" FontSize="13" Margin="0,7,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="每一份支持，都让我们的方块世界走得更远。" Foreground="{DynamicResource ColorBrush2}" FontSize="12" Margin="0,5,0,18" TextWrapping="Wrap" />
                    <Rectangle Height="1" Fill="{DynamicResource ColorBrushCardLine}" />
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="爱发电赞助通道" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="支持 BRS 服务器的运行与维护" FontSize="12" Foreground="{DynamicResource ColorBrush2}" Margin="0,5,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="afdian.com/a/brszz" FontSize="11" Foreground="{DynamicResource ColorBrush2}" Margin="0,5,0,0" />
                        </StackPanel>
                        <local:MyButton x:Name="BtnSponsor" Grid.Column="1" Text="前往爱发电 ↗" ColorType="Highlight" Height="34" Padding="16,0" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </local:MyCard>
            <local:MyCard UseAnimation="False" Margin="0,14,0,0">
                <StackPanel Margin="20,18">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="赞助鸣谢名单" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock x:Name="LabSummary" Text="感谢每一份心意" FontSize="12" Foreground="{DynamicResource ColorBrush2}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <local:MyButton x:Name="BtnRefresh" Grid.Column="1" Text="刷新名单" Height="28" Padding="12,0" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock x:Name="LabUpdated" Text="正在获取赞助名单…" FontSize="11" Foreground="{DynamicResource ColorBrush2}" Margin="0,8,0,16" TextWrapping="Wrap" />
                    <StackPanel x:Name="PanSponsors" />
                    <local:MyButton x:Name="BtnWebsite" Text="查看原站鸣谢页 ↗" Height="28" Padding="12,0" HorizontalAlignment="Left" Margin="0,12,0,0" />
                    <TextBlock x:Name="LabFooter" Text="名单与 BRS 原站同步，感谢大家的支持。" FontSize="11" Foreground="{DynamicResource ColorBrush2}" Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="19" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
