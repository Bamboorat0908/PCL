<local:MyPageRight xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:BRCL"
    x:Class="PageSetupChangelog" PanScroll="PanBack">
    <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,16,20,20">
            <local:MyCard UseAnimation="False">
                <StackPanel Margin="20,18">
                    <TextBlock Text="更新日志" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="记录 BRCL 的功能更新、体验优化与问题修复。" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="21" />
                    <TextBlock x:Name="LabVersion" FontSize="12" Foreground="{DynamicResource ColorBrush3}" Margin="0,10,0,0" TextWrapping="Wrap" />
                    <WrapPanel Margin="0,14,0,-6">
                        <local:MyButton x:Name="BtnCopy" Text="复制更新日志" Icon="{StaticResource BrclGeometryCopy}" Height="32" Padding="12,0" Margin="0,0,8,6" />
                        <local:MyButton x:Name="BtnCheckUpdate" Text="检查更新" Icon="{StaticResource BrclGeometryRefresh}" Height="32" Padding="12,0" Margin="0,0,0,6" />
                    </WrapPanel>
                </StackPanel>
            </local:MyCard>
            <StackPanel x:Name="PanEntries" />
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
