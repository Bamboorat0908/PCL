<local:MyPageLeft
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BRCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="PageSetupLeft"
             d:DesignWidth="152" AnimatedControl="PanItem">
    <StackPanel Margin="0,12,0,0" x:Name="PanItem">
        <local:MyListItem x:Name="ItemLaunch" IsScaleAnimationEnabled="False" Checked="True" Tag="0" MinPaddingRight="35" Height="36" VerticalAlignment="Top" Title="启动" Type="RadioBox"
            LogoScale="0.85" Logo="{StaticResource BrclIconLaunch}">
            <local:MyListItem.Buttons>
                <x:Array Type="{x:Type local:MyIconButton}">
                    <local:MyIconButton Tag="0" ToolTip="初始化本页设置" ToolTipService.InitialShowDelay="200" Click="Reset" Logo="{StaticResource BrclIconReset}" LogoScale="0.85" />
                </x:Array>
            </local:MyListItem.Buttons>
        </local:MyListItem>
        <local:MyListItem x:Name="ItemPrivacy" IsScaleAnimationEnabled="False" Tag="7" MinPaddingRight="20" Height="36" VerticalAlignment="Top" Title="隐私与诊断" Type="RadioBox"
            LogoScale="0.85" Logo="{StaticResource BrclIconShield}" />
        <local:MyListItem x:Name="ItemLink" IsScaleAnimationEnabled="False" Tag="1" MinPaddingRight="35" Height="36" VerticalAlignment="Top" Title="联机" Type="RadioBox"
            LogoScale="0.85" Logo="{StaticResource BrclIconLink}" >
            <local:MyListItem.Buttons>
                <x:Array Type="{x:Type local:MyIconButton}">
                    <local:MyIconButton Tag="1" ToolTip="初始化本页设置" ToolTipService.InitialShowDelay="200" Click="Reset" Logo="{StaticResource BrclIconReset}" LogoScale="0.85" />
                </x:Array>
            </local:MyListItem.Buttons>
        </local:MyListItem>
        
        <local:MyListItem x:Name="ItemSound" IsScaleAnimationEnabled="False" Tag="4" MinPaddingRight="35" Height="36" VerticalAlignment="Top" Title="音效" Type="RadioBox"
            LogoScale="0.85" Logo="{StaticResource BrclIconVolume}" />
        <local:MyListItem x:Name="ItemInstance" IsScaleAnimationEnabled="False" MinPaddingRight="35" Height="36" VerticalAlignment="Top" Title="版本设置" Type="Clickable"
            ToolTip="设置当前 BRS 实例；其他实例可从版本选择中的齿轮进入" LogoScale="0.85"
            Logo="{StaticResource BrclIconPackage}" />
        <local:MyListItem x:Name="ItemUpdate" IsScaleAnimationEnabled="False" MinPaddingRight="35" Height="36" VerticalAlignment="Top" Title="检查更新" Type="Clickable"
            ToolTip="检查 BRCL 启动器的新版本" LogoScale="0.85"
            Logo="{StaticResource BrclIconRefresh}" />
        <local:MyListItem x:Name="ItemChangelog" IsScaleAnimationEnabled="False" Tag="6" MinPaddingRight="20" Height="36" VerticalAlignment="Top" Title="更新日志" Type="RadioBox"
            ToolTip="查看 BRCL 的版本更新与改动记录" LogoScale="0.85"
            Logo="{StaticResource BrclIconChangelog}" />
        <local:MyListItem x:Name="ItemSponsors" IsScaleAnimationEnabled="False" Tag="5" MinPaddingRight="20" Height="36" VerticalAlignment="Top" Title="赞助鸣谢" Type="RadioBox"
            LogoScale="0.85" Logo="{StaticResource BrclIconHeart}" />
        <local:MyListItem x:Name="ItemAbout" IsScaleAnimationEnabled="False" Tag="3" MinPaddingRight="35" Height="36" VerticalAlignment="Top" Title="关于" Type="RadioBox"
            LogoScale="0.85" Logo="{StaticResource BrclIconInfo}">

        </local:MyListItem>
    </StackPanel>
</local:MyPageLeft>
