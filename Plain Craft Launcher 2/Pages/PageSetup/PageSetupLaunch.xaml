<local:MyPageRight xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:System="clr-namespace:System;assembly=mscorlib" mc:Ignorable="d" x:Class="PageSetupLaunch" PanScroll="PanBack">
    <local:MyPageRight.Resources>
        <Style x:Key="LaunchSectionExpander" TargetType="Expander">
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Foreground" Value="{DynamicResource ColorBrush1}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="{DynamicResource ColorBrush7}" BorderBrush="{DynamicResource ColorBrushCardLine}" BorderThickness="1" CornerRadius="3">
                            <DockPanel>
                                <ToggleButton x:Name="HeaderSite" DockPanel.Dock="Top" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Content="{TemplateBinding Header}" Foreground="{TemplateBinding Foreground}" FocusVisualStyle="{StaticResource BrclFocusVisual}" MinHeight="44" HorizontalContentAlignment="Stretch">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="HeaderSurface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="15,10" CornerRadius="2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" TextElement.FontSize="13" TextElement.FontWeight="SemiBold"/>
                                                    <Path x:Name="Chevron" Grid.Column="1" Data="M2 4 L8 10 L14 4" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" Stretch="Uniform" Width="10" Height="6" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="HeaderSurface" Property="Background" Value="{DynamicResource ColorBrush6}"/>
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                          <Setter TargetName="HeaderSurface" Property="BorderBrush" Value="{DynamicResource ColorBrush3}"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Chevron" Property="Data" Value="M2 10 L8 4 L14 10"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="SectionBody" ContentSource="Content" Margin="20,0,20,18" Visibility="Collapsed"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="SectionBody" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </local:MyPageRight.Resources>
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="20,20,20,10">
            <local:MyCard x:Name="CardArgument" Margin="0,0,0,15" Title="常用启动设置">
                <StackPanel Margin="20,40,20,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" MinHeight="28"/>
                            <RowDefinition Height="9"/>
                            <RowDefinition Height="Auto" MinHeight="28"/>
                            <RowDefinition Height="9"/>
                            <RowDefinition Height="Auto" MinHeight="28"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Left" Text="默认版本隔离" Margin="0,0,25,0"/>
                        <local:MyComboBox local:SettingService.Key="LaunchArgumentIndieV2" x:Name="ComboArgumentIndieV2" Grid.Row="0" Grid.ColumnSpan="2" Grid.Column="1" ToolTip="当安装新版本时，据此自动设置新版本的隔离选项。&#10;若想调整已有版本的隔离策略，请前往它的版本设置。">
                            <local:MyComboBoxItem Content="关闭" ToolTip="所有版本均使用同一档案，存档、Mod、资源包等均为公用。&#10;若存在多个安装了 Mod 的版本，可能会导致 Mod 冲突。"/>
                            <local:MyComboBoxItem Content="隔离可安装 Mod 的版本" ToolTip="可安装 Mod 的版本（例如 Forge、Fabric）均互相独立以避免 Mod 冲突，其他版本（例如原版）则不会被隔离。"/>
                            <local:MyComboBoxItem Content="隔离非正式版" ToolTip="将 Minecraft 快照、预发布版、远古版本、愚人节版本与其他版本进行隔离。"/>
                            <local:MyComboBoxItem Content="隔离可安装 Mod 的版本与非正式版" ToolTip="将可安装 Mod 的版本、Minecraft 快照、预发布版、远古版本、愚人节版本与其他版本进行隔离。"/>
                            <local:MyComboBoxItem Content="隔离所有版本" ToolTip="不同版本之间的存档、Mod、资源包等均不互通。&#10;这会导致不同原版版本间的存档不能共用，所以一般不推荐。"/>
                        </local:MyComboBox>
                        <TextBlock VerticalAlignment="Center" Grid.Row="2" HorizontalAlignment="Left" Text="启动器可见性" Margin="0,0,25,0"/>
                        <local:MyComboBox local:SettingService.Key="LaunchArgumentVisible" x:Name="ComboArgumentVisibie" Grid.Row="2" Grid.ColumnSpan="2" Grid.Column="1">
                            <local:MyComboBoxItem Content="游戏启动后立即关闭"/>
                            <local:MyComboBoxItem Content="游戏启动后隐藏，游戏退出后自动关闭" local:SettingService.Value="2"/>
                            <local:MyComboBoxItem Content="游戏启动后隐藏，游戏退出后重新打开" local:SettingService.Value="3"/>
                            <local:MyComboBoxItem Content="游戏启动后最小化" local:SettingService.Value="4"/>
                            <local:MyComboBoxItem Content="游戏启动后仍保持不变" local:SettingService.Value="5"/>
                        </local:MyComboBox>
                        <TextBlock VerticalAlignment="Center" Grid.Row="4" HorizontalAlignment="Left" Text="窗口大小" Margin="0,0,25,0"/>
                        <Grid x:Name="PanArgumentWindow" Grid.Row="4" Grid.ColumnSpan="2" Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <local:MyComboBox local:SettingService.Key="LaunchArgumentWindowType" x:Name="ComboArgumentWindowType">
                                <local:MyComboBoxItem Content="全屏"/>
                                <local:MyComboBoxItem Content="默认"/>
                                <local:MyComboBoxItem Content="与启动器尺寸一致"/>
                                <local:MyComboBoxItem Content="自定义尺寸" ToolTip="Forge 1.12.2 等个别版本存在 Bug，会导致高度设定无效"/>
                                <local:MyComboBoxItem Content="最大化"/>
                            </local:MyComboBox>
                            <local:MyTextBox local:SettingService.Key="LaunchArgumentWindowWidth" x:Name="TextArgumentWindowWidth" Padding="0,0,5,0" Visibility="Collapsed" Grid.Column="1" Margin="8,0,0,0" Width="60" HorizontalContentAlignment="Center" Text="854">
                                <local:MyTextBox.ValidateRules>
                                    <local:ValidateInteger Min="1" Max="99999"/>
                                </local:MyTextBox.ValidateRules>
                            </local:MyTextBox>
                            <TextBlock x:Name="LabArgumentWindowMiddle" Visibility="Collapsed" Grid.Column="2" Text=" × " VerticalAlignment="Center" FontSize="18"/>
                            <local:MyTextBox local:SettingService.Key="LaunchArgumentWindowHeight" x:Name="TextArgumentWindowHeight" Padding="0,0,5,0" Visibility="Collapsed" Grid.Column="3" Width="60" HorizontalContentAlignment="Center" Text="480" ToolTip="Forge 1.12.2 等个别版本存在 Bug，会导致高度设定无效">
                                <local:MyTextBox.ValidateRules>
                                    <local:ValidateInteger Min="1" Max="99999"/>
                                </local:MyTextBox.ValidateRules>
                            </local:MyTextBox>
                        </Grid>
                    </Grid>
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="内存分配">
                <StackPanel Margin="20,40,20,18">
                    <Grid Margin="0,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="9"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="9"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <local:MyRadioBox local:SettingService.Key="LaunchRamType" local:SettingService.Value="0" Text="自动配置" Width="110" Checked="True" x:Name="RadioRamType0" Margin="0,0,20,0" ToolTip="根据安装的 Mod 量与电脑剩余内存，动态调整为游戏分配的内存"/>
                        <local:MyRadioBox local:SettingService.Key="LaunchRamType" local:SettingService.Value="1" Grid.Row="2" Text="自定义" x:Name="RadioRamType1" Margin="0,0,20,0"/>
                        <local:MySlider Grid.Row="2" Grid.Column="1" IsEnabled="False" x:Name="SliderRamCustom" local:SettingService.Key="LaunchRamCustom" MaxValue="49" Value="13" AutomationProperties.Name="自定义游戏内存"/>
                        <local:MyCheckBox local:SettingService.Key="LaunchArgumentRam" Grid.Row="4" Grid.ColumnSpan="3" Text="启动游戏前进行内存优化" Height="22" x:Name="CheckArgumentRam" ToolTip="内存优化能将当前物理内存占用降低约 1/3，不仅限于 MC！&#10;如果使用机械硬盘，这还可能会导致一小段时间的严重卡顿。&#10;使用 --memory 参数启动 BRCL 可以静默执行内存优化。"/>
                        <!--<local:MyTextBox Grid.Row="2" Grid.Column="3" Width="100" VerticalAlignment="Center" Margin="30,0,0,0" Text="2048 MB" />-->
                    </Grid>
                    <Grid x:Name="PanRamDisplay" Margin="0,11,2,0" SnapsToDevicePixels="True" Grid.Row="1" Grid.ColumnSpan="2" Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ColumnRamUsed" Width="4.7*"/>
                            <ColumnDefinition x:Name="ColumnRamGame" Width="2.5*"/>
                            <ColumnDefinition x:Name="ColumnRamEmpty" Width="0.7*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition Height="4"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Rectangle x:Name="RectRamUsed" Grid.Row="1" StrokeThickness="0">
                            <Rectangle.Fill>
                                <LinearGradientBrush EndPoint="1,0.5" StartPoint="0,0.5">
                                    <GradientStop Color="{DynamicResource ColorObject3}" Offset="0"/>
                                    <GradientStop Color="{DynamicResource ColorObject2}" Offset="0.5"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle Grid.Row="1" StrokeThickness="0" Grid.Column="1" Fill="{DynamicResource ColorBrush3}" Opacity="0.5" x:Name="RectRamGame"/>
                        <Rectangle x:Name="RectRamEmpty" Grid.Row="1" StrokeThickness="0" Grid.Column="2" Fill="{DynamicResource ColorBrush6}" Opacity="0.7"/>
                        <TextBlock x:Name="LabRamUsedTitle" Text="已使用内存" Grid.ColumnSpan="3" Opacity="0.7" TextTrimming="None" Margin="2,0,0,5" FontSize="11" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="LabRamGameTitle" Text="游戏分配" Opacity="0.7" Grid.ColumnSpan="3" TextTrimming="None" Margin="2,0,0,5" FontSize="11" HorizontalAlignment="Left"/>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Grid.ColumnSpan="3" Margin="2,3,0,0" HorizontalAlignment="Left">
                            <TextBlock x:Name="LabRamUsed" Text="4.7 GB" FontSize="16" Foreground="{DynamicResource ColorBrush1}" TextTrimming="None"/>
                            <TextBlock x:Name="LabRamTotal" Text=" / 7.9 GB" FontSize="16" Foreground="{DynamicResource ColorBrush1}" TextTrimming="None"/>
                        </StackPanel>
                        <TextBlock Grid.Row="2" x:Name="LabRamGame" Text="2.5 GB" Grid.ColumnSpan="3" TextTrimming="None" Margin="2,3,0,0" FontSize="16" Foreground="{DynamicResource ColorBrush1}" HorizontalAlignment="Left"/>
                    </Grid>
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="Java 运行环境">
                <StackPanel Margin="20,40,20,18">
                    <local:MyCheckBox x:Name="CheckJavaAutoSelect" local:SettingService.Key="LaunchJavaAutoSelect" Text="自动管理推荐的 Java" MinHeight="26" ToolTip="启动游戏时，优先使用本机符合游戏与模组要求的推荐 Java 主版本；缺少该主版本时自动下载并切换。&#10;关闭后按 Java 列表顺序选择兼容版本；没有兼容版本时仍会尝试自动下载。&#10;需要固定使用某个 Java，可在版本设置中手动指定。"/>
                    <TextBlock Text="开启后，启动时优先使用本机推荐主版本的 Java，缺少时自动下载并选择。" TextWrapping="Wrap" Margin="0,5,0,12" FontSize="12" Foreground="{DynamicResource ColorBrush2}"/>
                    <Grid Margin="0,0,0,12" MinHeight="30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Java 下载源" VerticalAlignment="Center" Margin="0,0,25,0"/>
                        <local:MyComboBox x:Name="ComboJavaDownloadSource" local:SettingService.Key="LaunchJavaDownloadSource" Grid.Column="1" AutomationProperties.Name="Java 下载源" ToolTip="自动模式会在可用的中国镜像与官方源之间测速，优先使用最快的源，失败时尝试其他源。&#10;手动选择后仅使用指定的下载源。">
                            <local:MyComboBoxItem Content="自动测速（推荐）" local:SettingService.Value="0"/>
                            <local:MyComboBoxItem Content="官方源（Mojang / Adoptium）" local:SettingService.Value="1"/>
                            <local:MyComboBoxItem Content="BMCLAPI 中国镜像" local:SettingService.Value="2"/>
                            <local:MyComboBoxItem Content="清华大学 TUNA 镜像" local:SettingService.Value="3"/>
                            <local:MyComboBoxItem Content="南京大学 NJU 镜像" local:SettingService.Value="4"/>
                        </local:MyComboBox>
                    </Grid>
                    <Grid Height="30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,25,0" Grid.Column="0">
                            <TextBlock Text="Java 列表" VerticalAlignment="Center"/>
                            <local:MyIconButton Height="23" Margin="0,1,0,0" VerticalAlignment="Center" Theme="Color" CanClick="False" ToolTip="自动管理开启时，BRCL 会优先选择推荐主版本的 Java。&#10;关闭自动管理后，按列表顺序选择第一个兼容的 Java，可通过右侧箭头调整优先级。&#10;需要固定使用某个 Java，请在版本设置中选择“使用指定的 Java”。" ToolTipService.InitialShowDelay="0" Opacity="0.7" Logo="{StaticResource BrclIconHelp}" Width="23"/>
                        </StackPanel>
                        <Grid x:Name="PanAdvanceJava" Grid.Column="1" HorizontalAlignment="Stretch" MinWidth="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <local:MyComboBox x:Name="ComboAdvanceJava" Grid.Column="0" AutomationProperties.Name="Java 运行环境列表">
                                <!--<local:MyComboBoxItem Content="Java 8 (1.8.0_171)，64 位：C:\Program Files (x86)\Common Files\Oracle\Java\javapath\javaw.exe" IsSelected="True" ToolTip="C:\Program Files (x86)\Common Files\Oracle\Java\javapath\javaw.exe" />-->
                            </local:MyComboBox>
                            <TextBlock x:Name="LabAdvanceJava" Grid.Column="0" Margin="8.5,0,21.5,0" IsHitTestVisible="False" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <local:MyIconButton Margin="5,2,0,2" Grid.Column="1" x:Name="BtnAdvanceJavaSearch" Logo="{StaticResource BrclIconRefresh}" ToolTip="重新搜索电脑中的 Java" AutomationProperties.Name="重新搜索 Java" Height="26" Width="28"/>
                        </Grid>
                    </Grid>
                    <TextBlock Text="可导入已有 Java；关闭自动管理后可调整列表优先级。要固定使用某个 Java，请前往版本设置。" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="12" Foreground="{DynamicResource ColorBrush2}"/>
                </StackPanel>
            </local:MyCard>
            <Expander Header="外观与运行行为" Style="{StaticResource LaunchSectionExpander}" IsExpanded="False" x:Name="SectionAppearance">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Name"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" MinHeight="28"/>
                        <RowDefinition Height="9"/>
                        <RowDefinition Height="Auto" MinHeight="28"/>
                        <RowDefinition Height="9"/>
                        <RowDefinition Height="Auto" MinHeight="28"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Left" Text="游戏窗口标题" Margin="0,0,25,0"/>
                    <local:MyTextBox local:SettingService.Key="LaunchArgumentTitle" Grid.Row="0" Grid.ColumnSpan="2" Grid.Column="1" ToolTip="自定义游戏窗口的标题，若留空则不进行更改。&#10;你可以用替换标记来动态改变其内容，在帮助文档中搜索 “替换标记” 以了解用法。" HintText="默认" MaxLength="100"/>
                    <TextBlock Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Left" Text="自定义信息" Margin="0,0,25,0"/>
                    <local:MyTextBox local:SettingService.Key="LaunchArgumentInfo" Grid.Row="2" Grid.ColumnSpan="2" Text="BRCL" Grid.Column="1" ToolTip="注意：Mojang 于 Minecraft 26.1 移除了该设置，因此该设置在新版本中无效。&#10;&#10;该信息会显示在游戏主界面的左下角，与 F3 调试页面的左上角。&#10;你可以用替换标记来动态改变其内容，在帮助文档中搜索 “替换标记” 以了解用法。">
                        <local:MyTextBox.ValidateRules>
                            <local:ValidateExcept>
                                <local:ValidateExcept.Excepts>
                                    <System:String>"</System:String>
                                    <System:String>“</System:String>
                                    <System:String>”</System:String>
                                </local:ValidateExcept.Excepts>
                            </local:ValidateExcept>
                        </local:MyTextBox.ValidateRules>
                    </local:MyTextBox>
                    <TextBlock VerticalAlignment="Center" Grid.Row="4" HorizontalAlignment="Left" Text="进程优先级" Margin="0,0,25,0"/>
                    <local:MyComboBox local:SettingService.Key="LaunchArgumentPriority" Grid.Row="4" Grid.ColumnSpan="2" Grid.Column="1">
                        <local:MyComboBoxItem Content="高（优先保证游戏运行，游戏性能更佳，但可能造成其他程序卡顿）"/>
                        <local:MyComboBoxItem Content="中（平衡）"/>
                        <local:MyComboBoxItem Content="低（优先保证其他程序运行，但可能让游戏卡顿，适合挂机时使用）"/>
                    </local:MyComboBox>
                </Grid>
            </Expander>
            <Expander Header="高级启动参数与兼容性" Style="{StaticResource LaunchSectionExpander}" IsExpanded="False" x:Name="SectionAdvanced">
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="9"/>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="9"/>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="9"/>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,25,0">
                        <TextBlock Text="Java 虚拟机参数" VerticalAlignment="Center"/>
                        <local:MyIconButton Height="23" Margin="0,1,0,0" x:Name="BtnAdvanceJvmReset" VerticalAlignment="Center" ToolTip="还原" ToolTipService.InitialShowDelay="200" Logo="{StaticResource BrclIconReset}" LogoScale="0.9"/>
                    </StackPanel>
                    <local:MyTextBox local:SettingService.Key="LaunchAdvanceJvm" x:Name="TextAdvanceJvm" Grid.ColumnSpan="2" Grid.Column="1" ToolTip="启动 Minecraft 时使用的额外 JVM 参数，除非有确定把握，否则请不要修改。&#10;&#10;支持 Minecraft 版本 JSON 中的字符串替换标记，例如 ${library_directory}。&#10;也支持使用 BRCL 的替换标记，在帮助文档中搜索 “替换标记” 以了解用法。" MaxLength="4000" Height="100" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="0,5" VerticalScrollBarVisibility="Auto"/>
                    <TextBlock Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Left" Text="游戏参数" Margin="0,0,25,0"/>
                    <local:MyTextBox local:SettingService.Key="LaunchAdvanceGame" x:Name="TextAdvanceGame" Grid.Row="2" Grid.ColumnSpan="2" Grid.Column="1" ToolTip="文本框中的内容将会被直接拼合在启动参数的末尾。&#10;例如，输入 --demo 则会以试玩模式启动游戏。&#10;&#10;支持 Minecraft 版本 JSON 中的字符串替换标记，例如 ${library_directory}。&#10;也支持使用 BRCL 的替换标记，在帮助文档中搜索 “替换标记” 以了解用法。"/>
                    <TextBlock Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Left" Text="启动前执行命令" Margin="0,0,25,0"/>
                    <local:MyTextBox local:SettingService.Key="LaunchAdvanceRun" x:Name="TextAdvanceRun" Grid.Row="4" Grid.ColumnSpan="2" Grid.Column="1" HintText="" ToolTip="在 MC 启动前执行特定命令或程序，语法与 Windows 的命令提示符一致。&#10;&#10;你可以用替换标记来动态改变其内容或实现相对路径，在帮助文档中搜索 “替换标记” 以了解用法。例如：&#10; · &quot;{verpath}test.exe&quot; ：运行版本文件夹下的 test.exe 程序&#10; · &quot;{java}java.exe&quot; -jar &quot;{verpath}test.jar&quot; ：用 Java 运行版本文件夹下的 test.jar&#10; · notepad &quot;{verindie}options.txt&quot; ：使用记事本打开该版本的设置文件&#10;&#10;涉及路径的操作最好都打上双引号，以避免路径中的空格导致运行失败。&#10;执行命令时，命令行所在的目录是当前的 .minecraft 文件夹。"/>
                    <local:MyCheckBox local:SettingService.Key="LaunchAdvanceRunWait" x:Name="CheckAdvanceRunWait" Grid.Row="5" Grid.Column="1" Visibility="Collapsed" Text="等待命令执行完成后再继续启动" Margin="0,8,0,7"/>
                    <TextBlock VerticalAlignment="Center" Grid.Row="7" HorizontalAlignment="Left" Text="内存管理" Margin="0,0,25,0"/>
                    <local:MyComboBox local:SettingService.Key="LaunchAdvanceGC" Grid.Row="7" Grid.ColumnSpan="2" Grid.Column="1">
                        <local:MyComboBoxItem Content="尽量使用 ZGC" ToolTip="在 Java 21+ 使用分代 ZGC，20~15 使用非分代的 ZGC，14- 使用 G1GC。&#10;ZGC 的内存占用比 G1GC 更高，不过在回收内存时不会导致卡顿。&#10;覆盖 “Java 虚拟机参数” 设置中的 GC 相关参数。"/>
                        <local:MyComboBoxItem Content="尽量使用分代 ZGC" ToolTip="在 Java 21+ 使用分代 ZGC，20- 使用 G1GC。&#10;ZGC 的内存占用比 G1GC 更高，不过在回收内存时不会导致卡顿。&#10;覆盖 “Java 虚拟机参数” 设置中的 GC 相关参数。"/>
                        <local:MyComboBoxItem Content="标准 G1GC" ToolTip="总是使用 G1GC，附带 Mojang 官方的优化参数。&#10;G1GC 的内存占用比 ZGC 更低，但在回收内存时会导致突然的卡顿。&#10;覆盖 “Java 虚拟机参数” 设置中的 GC 相关参数。"/>
                        <local:MyComboBoxItem Content="调优 G1GC" local:SettingService.Value="4" ToolTip="总是使用 G1GC，附带 BRCL 调优过的优化参数。&#10;G1GC 的内存占用比 ZGC 更低，但在回收内存时会导致突然的卡顿。&#10;覆盖 “Java 虚拟机参数” 设置中的 GC 相关参数。"/>
                        <local:MyComboBoxItem Content="不指定（可自定义）" local:SettingService.Value="3" ToolTip="不自动添加 GC 参数。&#10;仅当选择此项时，你可以在 “Java 虚拟机参数” 设置中手动添加 GC 参数。"/>
                    </local:MyComboBox>
                    <StackPanel Margin="0,12,0,4" Grid.Row="8" Grid.ColumnSpan="2" HorizontalAlignment="Left">
                        <local:MyCheckBox Height="28" Text="禁用 Java Launch Wrapper" local:SettingService.Key="LaunchAdvanceDisableJLW" ToolTip="是否使用 Java Launch Wrapper 修复 Java 18- 在中文路径下可能无法正常启动的问题。&#10;详见：https://github.com/00ll00/java_launch_wrapper"/>
                        <local:MyCheckBox Height="28" Text="禁用 LWJGL Unsafe Agent" local:SettingService.Key="LaunchAdvanceDisableLUA" ToolTip="是否使用 LWJGL Unsafe Agent 修复 LWJGL 3.4.1 的一个性能问题。&#10;详见：https://github.com/HMCL-dev/lwjgl-unsafe-agent"/>
                        <local:MyCheckBox Height="28" Text="使用高性能显卡" local:SettingService.Key="LaunchAdvanceGraphicCard" ToolTip="自动在 Windows 设置 → 系统 → 屏幕 → 显示卡 中将 BRCL 和 Java 改为使用高性能显卡。&#10;如果同时有集成显卡和独立显卡，这能确保 MC 使用独立显卡进行渲染，以大幅提高帧率。"/>
                    </StackPanel>
                    <local:MyHint Text="版本独立设置中还有更多高级选项可供调整。" Margin="0,5,0,10" Theme="Blue" Grid.Row="9" Grid.ColumnSpan="2" CanClose="True" RelativeSetup="HintMoreAdvancedSetup"/>
                </Grid>
            </Expander>
            <Expander Header="离线皮肤（旧版本）" Style="{StaticResource LaunchSectionExpander}" IsExpanded="False" x:Name="CardSkin">
                <StackPanel Margin="0,4,0,0">
                    <local:MyHint Text="由于技术问题，此功能只保证对 1.19.2 以前的版本有效！" Theme="Yellow" Margin="0,0,0,10"/>
                    <Grid Margin="-1,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <local:MyRadioBox local:SettingService.Key="LaunchSkinType" local:SettingService.Value="0" x:Name="RadioSkinType0" Height="22" Grid.Column="0" Text="随机" ToolTip="随机选择一个默认皮肤"/>
                        <local:MyRadioBox local:SettingService.Key="LaunchSkinType" local:SettingService.Value="1" x:Name="RadioSkinType1" Height="22" Grid.Column="1" Text="Steve"/>
                        <local:MyRadioBox local:SettingService.Key="LaunchSkinType" local:SettingService.Value="2" x:Name="RadioSkinType2" Height="22" Grid.Column="2" Text="Alex"/>
                        <local:MyRadioBox local:SettingService.Key="LaunchSkinType" local:SettingService.Value="3" x:Name="RadioSkinType3" Height="22" Grid.Column="3" Text="正版皮肤" ToolTip="使用某个正版玩家的皮肤"/>
                        <local:MyRadioBox local:SettingService.Key="LaunchSkinType" local:SettingService.Value="4" x:Name="RadioSkinType4" Height="22" Grid.Column="4" Text="自定义" ToolTip="以资源包的形式加载自定义皮肤。&#10;使用此方式更换的皮肤在多人游戏中仅自己可见，且会替换游戏中所有的角色。"/>
                    </Grid>
                    <Grid x:Name="PanSkinID" Margin="0,14,0,2" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="正版玩家名" Margin="0,0,25,0"/>
                        <local:MyTextBox local:SettingService.Key="LaunchSkinID" Grid.Column="1" MaxLength="50"/>
                        <Grid Height="35" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Button"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Button"/>
                            </Grid.ColumnDefinitions>
                            <local:MyButton x:Name="BtnSkinSave" Text="保存皮肤" MinWidth="140" Padding="13,0" Margin="0,0,20,0" Grid.Row="1"/>
                            <local:MyButton x:Name="BtnSkinCache" Text="刷新" MinWidth="140" Padding="13,0" Margin="0,0,20,0" ToolTip="刷新并重新下载 BRCL 当前显示的皮肤" Grid.Row="1" Grid.Column="1"/>
                        </Grid>
                    </Grid>
                    <Grid x:Name="PanSkinChange" Margin="0,14,0,2" Height="35" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button"/>
                        </Grid.ColumnDefinitions>
                        <local:MyButton x:Name="BtnSkinChange" Text="更改皮肤" MinWidth="140" Padding="13,0" Margin="0,0,20,0"/>
                        <local:MyButton x:Name="BtnSkinDelete" Text="重置皮肤" MinWidth="140" Padding="13,0" Margin="0,0,20,0" ColorType="Red" Grid.Column="1"/>
                    </Grid>
                </StackPanel>
            </Expander>
            <local:MyExtraTextButton HorizontalAlignment="Center" Margin="0,-5,0,15" x:Name="BtnSwitch" Text="版本独立设置" LogoScale="0.9" Logo="{StaticResource BrclIconArrowRight}"/>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
