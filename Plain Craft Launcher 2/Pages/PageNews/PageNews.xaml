<local:MyPageRight xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PCL"
    x:Class="PageNews" PanScroll="ScrollMain">
    <Grid x:Name="NewsSurface" ClipToBounds="True" Background="Transparent">
    <local:MyScrollViewer x:Name="ScrollMain" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,16,20,20">
            <local:MyCard x:Name="CardMasthead" UseAnimation="False">
                <Grid ClipToBounds="True">
                    <Rectangle Height="3" VerticalAlignment="Top" Fill="{DynamicResource IndustrialAccent}" />
                    <StackPanel Margin="18,14,18,12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="ColumnArtwork" Width="64" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <WrapPanel x:Name="HeaderEyebrow">
                                <Border Background="{DynamicResource IndustrialAccent}" Padding="6,2" Margin="0,0,7,0"><TextBlock Text="BRS" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="#22251D" /></Border>
                                <TextBlock Text="NEWS / COMMUNITY" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource ColorBrush2}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </WrapPanel>
                            <TextBlock x:Name="HeaderTitle" Text="新闻与公告" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" />
                            <TextBlock x:Name="HeaderDescription" Text="服务器公告与社区动态，每一份新进展都在这里。" FontSize="12" Foreground="{DynamicResource ColorBrush2}" Margin="0,5,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Grid x:Name="NewsArtwork" Grid.Column="1" Width="64" Height="64" IsHitTestVisible="False" VerticalAlignment="Center">
                            <Border BorderBrush="{DynamicResource ColorBrushCardLine}" BorderThickness="1" Background="{DynamicResource ColorBrush8}" />
                            <Path Data="M0 0 H12 V2 H2 V12 H0 Z M52 62 H62 V52 H64 V64 H52 Z" Fill="{DynamicResource IndustrialAccent}" />
                            <Path Data="{StaticResource BrclGeometryNews}" Fill="{DynamicResource IndustrialAccent}" Width="34" Height="34" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                    <Rectangle Height="1" Fill="{DynamicResource ColorBrushCardLine}" Margin="0,12,0,10" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                            <Rectangle x:Name="DotSync" Width="6" Height="6" Fill="{DynamicResource IndustrialAccent}" Margin="0,0,7,0" />
                            <TextBlock x:Name="LabSync" Text="连接新闻频道" FontSize="12" Foreground="{DynamicResource ColorBrush2}" />
                        </StackPanel>
                        <local:MyButton x:Name="BtnRefresh" Grid.Column="1" Text="刷新" Icon="{StaticResource BrclGeometryRefresh}" Height="30" Padding="10,0" AutomationProperties.Name="刷新新闻频道" />
                    </Grid>
                    <TextBlock x:Name="LabStatus" Text="正在获取新闻…" FontSize="11" Foreground="{DynamicResource ColorBrush2}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </local:MyCard>

            <StackPanel x:Name="PanChannel" Margin="0,14,0,0">
                    <WrapPanel>
                        <local:MyButton x:Name="BtnAll" Text="全部" Tag="" ColorType="Highlight" Height="28" Padding="14,0" Margin="0,0,8,0" />
                        <local:MyButton x:Name="BtnAnnouncements" Text="公告" Tag="announcement" Height="28" Padding="14,0" Margin="0,0,8,0" />
                        <local:MyButton x:Name="BtnUpdates" Text="动态" Tag="update" Height="28" Padding="14,0" />
                    </WrapPanel>
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal"><Rectangle Width="3" Height="13" Fill="{DynamicResource IndustrialAccent}" Margin="0,0,8,0" /><TextBlock x:Name="LabChannel" Text="全部发布" FontSize="13" FontWeight="SemiBold" /></StackPanel>
                        <Rectangle Grid.Column="1" Height="1" Fill="{DynamicResource ColorBrushCardLine}" VerticalAlignment="Center" Margin="12,0" />
                        <TextBlock x:Name="LabCount" Grid.Column="2" Text="WAITING" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource ColorBrush2}" VerticalAlignment="Center" />
                    </Grid>
            </StackPanel>

            <local:MyCard x:Name="CardError" UseAnimation="False" Margin="0,14,0,0" Visibility="Collapsed">
                <StackPanel Margin="20,18">
                    <TextBlock Text="暂时无法获取新闻" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="请检查网络连接后重试，也可打开新闻网站查看。" Margin="0,8,0,14" Foreground="{DynamicResource ColorBrush2}" TextWrapping="Wrap" />
                    <WrapPanel>
                        <local:MyButton x:Name="BtnRetry" Text="重新加载" Height="30" Padding="14,0" ColorType="Highlight" Margin="0,0,8,0" />
                        <local:MyButton x:Name="BtnWebsite" Text="打开新闻网站" Icon="{StaticResource BrclGeometryExternal}" Height="30" Padding="14,0" />
                    </WrapPanel>
                </StackPanel>
            </local:MyCard>

            <local:MyCard x:Name="CardEmpty" UseAnimation="False" Margin="0,14,0,0" Visibility="Collapsed">
                <Grid ClipToBounds="True">
                <Grid Margin="20,28">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="60" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid Width="42" Height="56" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
                        <Path Data="{StaticResource BrclGeometryNews}" Fill="{DynamicResource ColorBrush2}" Stretch="Uniform" Width="38" Height="38" VerticalAlignment="Top" />
                        <Rectangle Width="8" Height="8" Fill="{DynamicResource IndustrialAccent}" VerticalAlignment="Bottom" HorizontalAlignment="Right" />
                    </Grid>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="CHANNEL / STANDBY" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource ColorBrush2}" />
                        <TextBlock x:Name="LabEmptyTitle" Text="还没有新闻" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0" />
                        <TextBlock Text="故事还在继续。新的服务器公告与动态，将在这里与你见面。" Margin="0,9,0,0" FontSize="12" LineHeight="21" Foreground="{DynamicResource ColorBrush2}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
                </Grid>
            </local:MyCard>

            <StackPanel x:Name="PanList">
                <StackPanel x:Name="PanItems" />
                <local:MyButton x:Name="BtnLoadMore" Text="加载更多" Height="32" Padding="20,0" HorizontalAlignment="Center" Margin="0,14,0,0" Visibility="Collapsed" />
            </StackPanel>

            <local:MyCard x:Name="CardDetail" UseAnimation="False" Margin="0,14,0,0" Visibility="Collapsed">
                <StackPanel Margin="20,18">
                    <local:MyButton x:Name="BtnBack" Text="返回新闻列表" Icon="{StaticResource BrclGeometryBack}" Height="30" Padding="10,0" HorizontalAlignment="Left" Margin="0,0,0,16" />
                    <TextBlock x:Name="LabDetailMeta" FontSize="11" Foreground="{DynamicResource ColorBrush2}" TextWrapping="Wrap" />
                    <TextBlock x:Name="LabDetailTitle" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,16" />
                    <Rectangle Height="1" Fill="{DynamicResource ColorBrushCardLine}" Margin="0,0,0,18" />
                    <TextBlock x:Name="LabDetailContent" FontSize="14" LineHeight="25" TextWrapping="Wrap" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
    </Grid>
</local:MyPageRight>
