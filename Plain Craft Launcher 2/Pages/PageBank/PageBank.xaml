<local:MyPageRight xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:BRCL"
    x:Class="PageBank" PanScroll="ScrollMain">
    <local:MyPageRight.Resources>
        <Style x:Key="BankAccountRow" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ColorBrush8}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ColorBrushCardLine}" />
            <Setter Property="Foreground" Value="{DynamicResource ColorBrush1}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="2"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ColorBrush6}" /></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource IndustrialAccent}" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.6" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
    </local:MyPageRight.Resources>
    <local:MyScrollViewer x:Name="ScrollMain" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,16,20,20">
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,10,0">
                    <WrapPanel><Border Background="{DynamicResource IndustrialAccent}" Padding="6,2" Margin="0,0,8,0"><TextBlock Text="BRS" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource IndustrialOnAccent}" /></Border><TextBlock Text="BANK" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource ColorBrush2}" VerticalAlignment="Center" /></WrapPanel>
                    <TextBlock Text="银行" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0" />
                    <TextBlock x:Name="LabWelcome" Text="查看团队资金，掌握账户变化。" FontSize="12" Foreground="{DynamicResource ColorBrush2}" Margin="0,5,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <local:MyButton x:Name="BtnPrivacy" Text="隐藏金额" Height="30" Padding="10,0" Margin="0,0,8,0" AutomationProperties.Name="隐藏或显示银行金额" />
                    <local:MyButton x:Name="BtnRefresh" Text="刷新" Icon="{StaticResource BrclGeometryRefresh}" Height="30" Padding="10,0" AutomationProperties.Name="刷新银行账户" />
                </StackPanel>
            </Grid>

            <local:MyCard x:Name="CardBalance" UseAnimation="False" Visibility="Collapsed">
                <Grid ClipToBounds="True">
                    <Rectangle Height="3" VerticalAlignment="Top" Fill="{DynamicResource IndustrialAccent}" />
                    <StackPanel Margin="20,18,20,16">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="当前账户" FontSize="11" Foreground="{DynamicResource ColorBrush2}" />
                                <TextBlock x:Name="LabAccountName" Text="尚未关联团队账户" FontSize="20" FontWeight="SemiBold" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Border Grid.Column="1" BorderBrush="{DynamicResource ColorBrushCardLine}" BorderThickness="1" Padding="8,4" VerticalAlignment="Top"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource BrclGeometryShield}" Fill="{DynamicResource ColorBrush3}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" /><TextBlock x:Name="LabConnection" Text="待关联" FontSize="10" Foreground="{DynamicResource ColorBrush2}" /></StackPanel></Border>
                        </Grid>
                        <Grid Margin="0,20,0,20">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="ColumnArtwork" Width="92" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="账户余额（铜币）" FontSize="12" Foreground="{DynamicResource ColorBrush2}" />
                                <TextBlock x:Name="LabBalance" Text="— —" FontFamily="Consolas" FontSize="36" FontWeight="Bold" Margin="0,7,0,0" TextWrapping="Wrap" AutomationProperties.Name="当前账户余额" />
                                <TextBlock x:Name="LabAccountTail" Text="登录后自动关联，无需另设银行密码。" FontSize="11" Margin="0,9,0,0" Foreground="{DynamicResource ColorBrush2}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Grid x:Name="BankArtwork" Grid.Column="1" Width="72" Height="72" VerticalAlignment="Center" HorizontalAlignment="Right" IsHitTestVisible="False">
                                <Border Background="{DynamicResource ColorBrush8}" BorderBrush="{DynamicResource ColorBrushCardLine}" BorderThickness="1" />
                                <Path Data="M0 0 H16 V2 H2 V16 H0 Z M56 70 H70 V56 H72 V72 H56 Z" Fill="{DynamicResource IndustrialAccent}" />
                                <Path Data="{StaticResource BrclGeometryBank}" Width="38" Height="38" Stretch="Uniform" Fill="{DynamicResource IndustrialAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                        <Rectangle Height="1" Fill="{DynamicResource ColorBrushCardLine}" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0"><Rectangle Width="6" Height="6" Fill="{DynamicResource IndustrialAccent}" Margin="0,0,7,0" /><TextBlock x:Name="LabSync" Text="等待登录" FontSize="11" Foreground="{DynamicResource ColorBrush2}" TextWrapping="Wrap" /></StackPanel>
                            <TextBlock Grid.Column="1" Text="团队共享银行" FontSize="11" Foreground="{DynamicResource ColorBrush2}" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </local:MyCard>

            <WrapPanel Margin="0,18,0,14">
                <local:MyButton x:Name="TabAccount" Text="账户总览" Tag="account" Height="30" Padding="14,0" ColorType="Highlight" Margin="0,0,8,0" />
                <local:MyButton x:Name="TabTransactions" Text="资金流水" Tag="transactions" Height="30" Padding="14,0" Margin="0,0,8,0" />
                <local:MyButton x:Name="TabAnalysis" Text="资产分析" Tag="analysis" Height="30" Padding="14,0" />
            </WrapPanel>

            <local:MyCard x:Name="CardNotice" UseAnimation="False" Margin="0,0,0,12">
                <Grid Margin="18,17">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Path Data="{StaticResource BrclGeometryShield}" Fill="{DynamicResource IndustrialAccent}" Width="21" Height="21" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,3,0,0" />
                    <StackPanel Grid.Column="1"><TextBlock x:Name="LabNoticeTitle" Text="登录后，自动关联你的团队银行" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock x:Name="LabNotice" Text="使用启动器的微软正版账号登录，即可查看你获得直接授权的团队账户。" FontSize="12" LineHeight="20" Foreground="{DynamicResource ColorBrush2}" Margin="0,7,0,0" TextWrapping="Wrap" /><local:MyButton x:Name="BtnLogin" Text="前往微软登录" Height="30" Padding="14,0" ColorType="Highlight" HorizontalAlignment="Left" Margin="0,12,0,0" /></StackPanel>
                </Grid>
            </local:MyCard>

            <local:MyCard x:Name="CardAccount" UseAnimation="False" Visibility="Collapsed">
                <StackPanel Margin="18,16">
                    <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Rectangle Width="3" Height="13" Fill="{DynamicResource IndustrialAccent}" Margin="0,0,8,0" /><TextBlock Text="我的团队账户" FontSize="14" FontWeight="SemiBold" /></StackPanel><TextBlock x:Name="LabAccountCount" Grid.Column="1" Text="尚未关联" Foreground="{DynamicResource ColorBrush2}" FontSize="11" VerticalAlignment="Center" /></Grid>
                    <StackPanel x:Name="PanAccountChoices" />
                    <TextBlock Text="点击账户即可切换查看。团队资金由获授权的成员共同使用。" FontSize="11" Foreground="{DynamicResource ColorBrush2}" Margin="0,5,0,0" TextWrapping="Wrap" />
                    <Rectangle Height="1" Fill="{DynamicResource ColorBrushCardLine}" Margin="0,16,0,12" />
                    <local:MyButton x:Name="BtnDetails" Text="查看当前账户详情" Height="28" Padding="10,0" HorizontalAlignment="Left" Icon="{StaticResource BrclGeometryDocument}" />
                    <StackPanel x:Name="PanDetails" Visibility="Collapsed" Margin="0,15,0,0">
                    <TextBlock Text="账户编号" FontSize="11" Foreground="{DynamicResource ColorBrush2}" Margin="0,0,0,5" />
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="LabAccountId" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,0,8,0" /><local:MyButton x:Name="BtnCopy" Grid.Column="1" Text="复制" Icon="{StaticResource BrclGeometryCopy}" Height="28" Padding="10,0" AutomationProperties.Name="复制完整银行账户编号" /></Grid>
                    <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="可见余额" FontSize="11" Foreground="{DynamicResource ColorBrush2}" /><TextBlock x:Name="LabVisible" Text="—" FontFamily="Consolas" FontSize="14" Margin="0,6,0,0" TextWrapping="Wrap" /></StackPanel><StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="溢出储备" FontSize="11" Foreground="{DynamicResource ColorBrush2}" /><TextBlock x:Name="LabReserve" Text="—" FontFamily="Consolas" FontSize="14" Margin="0,6,0,0" TextWrapping="Wrap" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="授权成员" FontSize="11" Foreground="{DynamicResource ColorBrush2}" /><TextBlock x:Name="LabMembers" Text="—" FontFamily="Consolas" FontSize="14" Margin="0,6,0,0" /></StackPanel></Grid>
                    <Rectangle Height="1" Fill="{DynamicResource ColorBrushCardLine}" Margin="0,16" />
                    <TextBlock Text="账户说明" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Text="你已获得此团队银行的直接访问授权。账户余额包含可见余额及溢出储备，背包和箱子中的实体硬币不计入其中。成员授权请在游戏内管理。" FontSize="11" LineHeight="20" Foreground="{DynamicResource ColorBrush2}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>

            <local:MyCard x:Name="CardTransactions" UseAnimation="False" Visibility="Collapsed">
                <StackPanel Margin="18,17">
                    <StackPanel Orientation="Horizontal"><Rectangle Width="3" Height="13" Fill="{DynamicResource IndustrialAccent}" Margin="0,0,8,0" /><TextBlock Text="资金流水" FontSize="14" FontWeight="SemiBold" /></StackPanel>
                    <Grid Margin="0,25,0,21"><Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Path Data="{StaticResource BrclGeometryDocument}" Fill="{DynamicResource ColorBrush2}" Width="30" Height="30" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Top" /><StackPanel Grid.Column="1"><TextBlock Text="流水服务尚未开放" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="服务器目前仅提供账户余额，尚未提供完整交易记录。开放后，你可以在这里查看每笔收支。" FontSize="12" LineHeight="21" Foreground="{DynamicResource ColorBrush2}" Margin="0,9,0,0" TextWrapping="Wrap" /><TextBlock Text="当前不据余额差额推算收入或支出。" FontSize="11" Foreground="{DynamicResource ColorBrush2}" Margin="0,11,0,0" TextWrapping="Wrap" /></StackPanel></Grid>
                </StackPanel>
            </local:MyCard>

            <local:MyCard x:Name="CardAnalysis" UseAnimation="False" Visibility="Collapsed">
                <StackPanel Margin="18,17">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Rectangle Width="3" Height="13" Fill="{DynamicResource IndustrialAccent}" Margin="0,0,8,0" /><TextBlock Text="余额走势" FontSize="14" FontWeight="SemiBold" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><local:MyButton x:Name="BtnDays7" Text="7天" Tag="7" Height="26" Padding="9,0" ColorType="Highlight" Margin="0,0,5,0" /><local:MyButton x:Name="BtnDays30" Text="30天" Tag="30" Height="26" Padding="9,0" Margin="0,0,5,0" /><local:MyButton x:Name="BtnDays90" Text="90天" Tag="90" Height="26" Padding="9,0" /></StackPanel></Grid>
                    <TextBlock x:Name="LabHistoryStatus" Text="关联账户后，查看已记录的余额走势。" FontSize="11" Foreground="{DynamicResource ColorBrush2}" Margin="0,12,0,0" TextWrapping="Wrap" />
                    <Grid x:Name="PanChart" Height="152" Margin="0,14,0,0" Background="{DynamicResource ColorBrush8}"><Canvas x:Name="ChartCanvas" ClipToBounds="True" /><TextBlock x:Name="LabChartEmpty" Text="暂无余额记录" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource ColorBrush2}" /></Grid>
                    <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="LabChartStart" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource ColorBrush2}" /><TextBlock x:Name="LabChartEnd" Grid.Column="1" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource ColorBrush2}" /></Grid>
                    <UniformGrid Columns="3" Margin="0,17,0,0"><StackPanel Margin="0,0,8,0"><TextBlock Text="期间余额变化" FontSize="11" Foreground="{DynamicResource ColorBrush2}" /><TextBlock x:Name="LabChange" Text="—" FontFamily="Consolas" FontSize="15" Margin="0,6,0,0" TextWrapping="Wrap" /></StackPanel><StackPanel Margin="0,0,8,0"><TextBlock Text="采样最高余额" FontSize="11" Foreground="{DynamicResource ColorBrush2}" /><TextBlock x:Name="LabHigh" Text="—" FontFamily="Consolas" FontSize="15" Margin="0,6,0,0" TextWrapping="Wrap" /></StackPanel><StackPanel><TextBlock Text="采样最低余额" FontSize="11" Foreground="{DynamicResource ColorBrush2}" /><TextBlock x:Name="LabLow" Text="—" FontFamily="Consolas" FontSize="15" Margin="0,6,0,0" TextWrapping="Wrap" /></StackPanel></UniformGrid>
                    <Rectangle Height="1" Fill="{DynamicResource ColorBrushCardLine}" Margin="0,17,0,12" />
                    <TextBlock Text="走势来自访问时采集的余额快照；间隔不固定，仅覆盖开始记录后的数据。完整收支分析将在流水服务开放后提供。" FontSize="11" Foreground="{DynamicResource ColorBrush2}" LineHeight="19" TextWrapping="Wrap" />
                </StackPanel>
            </local:MyCard>
            <TextBlock Text="BRS BANK / 团队资产服务" FontFamily="Consolas, Microsoft YaHei UI" FontSize="10" Foreground="{DynamicResource ColorBrush2}" Opacity="0.7" HorizontalAlignment="Center" Margin="0,18,0,0" />
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
