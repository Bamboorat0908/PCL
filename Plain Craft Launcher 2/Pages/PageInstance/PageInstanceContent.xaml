<local:MyPageRight xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PCL"
    x:Class="PageInstanceContent">
    <Grid Margin="25,22,25,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="LabTitle" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock x:Name="LabDescription" TextWrapping="Wrap" Foreground="{DynamicResource ColorBrush2}" Margin="0,7,0,8" FontSize="12"/>
            <TextBlock x:Name="LabPath" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource ColorBrush2}" FontSize="11" Margin="0,0,0,12"/>
        </StackPanel>
        <WrapPanel Grid.Row="1" x:Name="PanActions" Margin="0,0,0,8">
            <local:MyButton x:Name="BtnImport" Text="导入文件" TextPadding="12,0" MinWidth="92" Height="30" Margin="0,0,8,6"/>
            <local:MyButton x:Name="BtnImportFolder" Text="导入文件夹" TextPadding="12,0" MinWidth="92" Height="30" Margin="0,0,8,6"/>
            <local:MyButton x:Name="BtnExport" Text="导出 / 备份" TextPadding="12,0" MinWidth="92" Height="30" Margin="0,0,8,6"/>
            <local:MyButton x:Name="BtnFolder" Text="打开目录" TextPadding="12,0" MinWidth="92" Height="30" Margin="0,0,8,6"/>
            <local:MyButton x:Name="BtnRefresh" Text="刷新" TextPadding="12,0" MinWidth="92" Height="30" Margin="0,0,0,6"/>
        </WrapPanel>
        <local:MyTextBox Grid.Row="2" x:Name="TextSearch" HintText="按名称筛选…" Margin="0,0,0,10"/>
        <Grid Grid.Row="3" MinHeight="90">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ListBox x:Name="EntryList" Background="{DynamicResource ColorBrush8}" Foreground="{DynamicResource ColorBrush1}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="10,9"/><Setter Property="Margin" Value="0,0,0,4"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
                        <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ColorBrush6}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ColorBrush6}"/></Trigger></ControlTemplate.Triggers>
                    </ControlTemplate></Setter.Value></Setter>
                </Style></ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{DynamicResource ColorBrush2}" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="LabEmpty" Text="这里还没有内容，可以从上方导入。" TextWrapping="Wrap" Margin="16" Foreground="{DynamicResource ColorBrush2}" IsHitTestVisible="False"/>
            <Border x:Name="PanPreview" Grid.Column="1" Width="190" Margin="12,0,0,0" Background="{DynamicResource ColorBrush8}" Visibility="Collapsed">
                <Image x:Name="ImgPreview" Stretch="Uniform"/>
            </Border>
        </Grid>
        <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <WrapPanel x:Name="PanSelection">
                <local:MyButton x:Name="BtnOpen" Text="打开所选" TextPadding="12,0" MinWidth="92" Height="30" Margin="0,0,8,0"/>
                <local:MyButton x:Name="BtnRename" Text="重命名" TextPadding="12,0" MinWidth="92" Height="30" Margin="0,0,8,0"/>
                <local:MyButton x:Name="BtnRecycle" Text="移入回收站" TextPadding="12,0" MinWidth="92" Height="30"/>
            </WrapPanel>
            <TextBlock x:Name="LabStatus" TextWrapping="Wrap" Foreground="{DynamicResource ColorBrush2}" FontSize="11" Margin="0,9,0,0"/>
        </StackPanel>
    </Grid>
</local:MyPageRight>
